// Isolated Blog content-platform contract.
// This file is intentionally separate from /prisma/schema.prisma until validation is complete.
// No production migration should be applied from this file without review.

generator blogContentClient {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["blog_content"]
}

enum BlogLifecycleStatus {
  DISCOVERED
  RESEARCHING
  VERIFIED
  WRITING
  REVIEW
  READY
  PUBLISHED
  PAUSED
  ARCHIVED

  @@schema("blog_content")
}

enum BlogIndexEligibility {
  BLOCKED
  REVIEW_REQUIRED
  ELIGIBLE
  INDEXED
  REMOVED

  @@schema("blog_content")
}

enum BlogSourceKind {
  OFFICIAL_DOCUMENTATION
  GOVERNMENT
  STANDARD_BODY
  ORIGINAL_RESEARCH
  FIRST_PARTY
  ACADEMIC
  INDUSTRY_REPORT
  NEWS
  SECONDARY_REFERENCE

  @@schema("blog_content")
}

enum BlogSourceStatus {
  DISCOVERED
  ACTIVE
  STALE
  UNAVAILABLE
  REJECTED
  ARCHIVED

  @@schema("blog_content")
}

enum BlogClaimStatus {
  DRAFT
  VERIFIED
  DISPUTED
  STALE
  REJECTED
  ARCHIVED

  @@schema("blog_content")
}

enum BlogEvidenceStrength {
  PRIMARY
  STRONG
  MODERATE
  WEAK

  @@schema("blog_content")
}

enum BlogSectionKind {
  DIRECT_ANSWER
  INTRODUCTION
  EXPLANATION
  EXAMPLE
  STEPS
  COMPARISON
  TOOLS
  MISTAKES
  FAQ
  SOURCES
  CONCLUSION
  CTA
  CUSTOM

  @@schema("blog_content")
}

enum BlogContentOrigin {
  HUMAN
  ASSISTED
  GENERATED
  IMPORTED
  MIGRATED

  @@schema("blog_content")
}

enum BlogQualityRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  CANCELLED

  @@schema("blog_content")
}

enum BlogQualityCheckKind {
  REQUIRED_FIELDS
  MINIMUM_DEPTH
  SOURCE_COVERAGE
  CLAIM_SUPPORT
  EXACT_DUPLICATE
  NEAR_DUPLICATE
  SEMANTIC_SIMILARITY
  TITLE_SIMILARITY
  INTRO_SIMILARITY
  FAQ_REPETITION
  TEMPLATE_RATIO
  INTERNAL_LINKS
  EXTERNAL_LINKS
  SOURCE_FRESHNESS
  BROKEN_LINKS
  FACT_CONFLICT
  SCHEMA_ALIGNMENT
  INDEX_ELIGIBILITY
  HUMAN_REVIEW

  @@schema("blog_content")
}

enum BlogQualitySeverity {
  INFO
  WARNING
  ERROR
  BLOCKER

  @@schema("blog_content")
}

enum BlogReviewDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED

  @@schema("blog_content")
}

enum BlogPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  PAUSED
  RETIRED
  FAILED

  @@schema("blog_content")
}

enum BlogRefreshJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED

  @@schema("blog_content")
}

enum BlogAuditActorType {
  USER
  AGENT
  SYSTEM
  MIGRATION

  @@schema("blog_content")
}

enum BlogSimilarityKind {
  EXACT
  NORMALIZED
  TRIGRAM
  MINHASH
  SIMHASH
  SEMANTIC
  TITLE
  INTRO
  FAQ
  SECTION

  @@schema("blog_content")
}

model BlogContentWorkspace {
  id                   String                 @id @default(cuid())
  key                  String                 @unique
  name                 String
  locale               String                 @default("en-IN")
  defaultCanonicalHost String                 @default("https://sikhadenge.in")
  targetPageCapacity   Int                    @default(500000)
  settings             Json                   @default("{}")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  topics               BlogContentTopic[]
  audiences            BlogContentAudience[]
  searchIntents        BlogContentSearchIntent[]
  sources              BlogContentSource[]
  claims               BlogContentClaim[]
  pages                BlogContentPage[]
  refreshJobs          BlogContentRefreshJob[]
  auditEvents          BlogContentAuditEvent[]

  @@map("workspaces")
  @@schema("blog_content")
}

model BlogContentTopic {
  id          String             @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  entityType  String?
  parentId    String?
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   BlogContentWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      BlogContentTopic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    BlogContentTopic[] @relation("TopicHierarchy")
  outgoing    BlogContentTopicEdge[] @relation("TopicEdgeFrom")
  incoming    BlogContentTopicEdge[] @relation("TopicEdgeTo")
  pages       BlogContentPageTopic[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
  @@index([parentId])
  @@map("topics")
  @@schema("blog_content")
}

model BlogContentTopicEdge {
  id          String           @id @default(cuid())
  fromTopicId String
  toTopicId   String
  relation    String
  weight      Float            @default(1)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
  fromTopic   BlogContentTopic @relation("TopicEdgeFrom", fields: [fromTopicId], references: [id], onDelete: Cascade)
  toTopic     BlogContentTopic @relation("TopicEdgeTo", fields: [toTopicId], references: [id], onDelete: Cascade)

  @@unique([fromTopicId, toTopicId, relation])
  @@index([toTopicId, relation])
  @@map("topic_edges")
  @@schema("blog_content")
}

model BlogContentAudience {
  id          String                  @id @default(cuid())
  workspaceId String
  key         String
  label       String
  description String?
  attributes  Json                    @default("{}")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   BlogContentWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       BlogContentPage[]

  @@unique([workspaceId, key])
  @@index([workspaceId, label])
  @@map("audiences")
  @@schema("blog_content")
}

model BlogContentSearchIntent {
  id          String               @id @default(cuid())
  workspaceId String
  key         String
  label       String
  description String?
  intentClass String
  attributes  Json                 @default("{}")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   BlogContentWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages       BlogContentPage[]

  @@unique([workspaceId, key])
  @@index([workspaceId, intentClass])
  @@map("search_intents")
  @@schema("blog_content")
}

model BlogContentSource {
  id                String                  @id @default(cuid())
  workspaceId       String
  canonicalUrl      String
  host              String
  title             String?
  publisher         String?
  kind              BlogSourceKind
  status            BlogSourceStatus       @default(DISCOVERED)
  authorityScore    Float?
  trustNotes        String?
  robotsAllowed     Boolean?
  firstDiscoveredAt DateTime                @default(now())
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  metadata          Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         BlogContentWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots         BlogContentSourceSnapshot[]
  refreshJobs       BlogContentRefreshJob[]

  @@unique([workspaceId, canonicalUrl])
  @@index([workspaceId, status, nextCheckAt])
  @@index([host, kind])
  @@map("sources")
  @@schema("blog_content")
}

model BlogContentSourceSnapshot {
  id             String               @id @default(cuid())
  sourceId       String
  fetchedAt      DateTime             @default(now())
  httpStatus     Int?
  finalUrl       String?
  contentType    String?
  title          String?
  bodyText       String?
  bodyHash       String
  storageKey     String?
  publishedAt    DateTime?
  modifiedAt     DateTime?
  expiresAt      DateTime?
  extractionMeta Json                 @default("{}")
  source         BlogContentSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  evidence       BlogContentClaimEvidence[]

  @@unique([sourceId, bodyHash])
  @@index([sourceId, fetchedAt])
  @@index([expiresAt])
  @@map("source_snapshots")
  @@schema("blog_content")
}

model BlogContentClaim {
  id                String                 @id @default(cuid())
  workspaceId       String
  stableKey         String
  statement         String
  normalizedHash    String
  status            BlogClaimStatus        @default(DRAFT)
  confidence        Float                  @default(0)
  validFrom         DateTime?
  validUntil        DateTime?
  verifiedAt        DateTime?
  verifiedBy        String?
  contradictionNote String?
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  workspace         BlogContentWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence          BlogContentClaimEvidence[]
  sections          BlogContentSectionClaim[]

  @@unique([workspaceId, stableKey])
  @@unique([workspaceId, normalizedHash])
  @@index([workspaceId, status, validUntil])
  @@map("claims")
  @@schema("blog_content")
}

model BlogContentClaimEvidence {
  id          String                @id @default(cuid())
  claimId     String
  snapshotId  String
  strength    BlogEvidenceStrength
  quote       String?
  locator     String?
  supports    Boolean               @default(true)
  reviewer    String?
  reviewedAt  DateTime?
  metadata    Json                  @default("{}")
  createdAt   DateTime              @default(now())
  claim       BlogContentClaim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  snapshot    BlogContentSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([claimId, snapshotId, locator])
  @@index([snapshotId, supports])
  @@map("claim_evidence")
  @@schema("blog_content")
}

model BlogContentPage {
  id                 String                    @id @default(cuid())
  workspaceId        String
  slug               String
  canonicalPath      String
  title              String
  primaryKeyword     String?
  secondaryKeywords  String[]                  @default([])
  uniqueAngle        String
  userProblem        String
  expectedOutcome    String
  lifecycleStatus    BlogLifecycleStatus       @default(DISCOVERED)
  indexEligibility   BlogIndexEligibility      @default(BLOCKED)
  audienceId         String?
  intentId           String?
  locale             String                    @default("en-IN")
  priority           Int                       @default(0)
  sourceRecordKey    String?
  publishedVersionId String?                   @unique
  firstPublishedAt   DateTime?
  lastPublishedAt    DateTime?
  lastAuditedAt      DateTime?
  nextAuditAt        DateTime?
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  workspace          BlogContentWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audience           BlogContentAudience?      @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  intent             BlogContentSearchIntent?  @relation(fields: [intentId], references: [id], onDelete: SetNull)
  topics             BlogContentPageTopic[]
  versions           BlogContentPageVersion[]  @relation("PageVersions")
  publications       BlogContentPublication[]
  refreshJobs        BlogContentRefreshJob[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, canonicalPath])
  @@index([workspaceId, lifecycleStatus, priority])
  @@index([workspaceId, indexEligibility, nextAuditAt])
  @@index([audienceId, intentId])
  @@map("pages")
  @@schema("blog_content")
}

model BlogContentPageTopic {
  pageId    String
  topicId   String
  isPrimary Boolean          @default(false)
  weight    Float            @default(1)
  page      BlogContentPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  topic     BlogContentTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([pageId, topicId])
  @@index([topicId, isPrimary])
  @@map("page_topics")
  @@schema("blog_content")
}

model BlogContentPageVersion {
  id                   String                @id @default(cuid())
  pageId               String
  versionNumber        Int
  status               BlogLifecycleStatus  @default(WRITING)
  origin               BlogContentOrigin
  title                String
  metaTitle            String
  metaDescription      String
  h1                   String
  directAnswer         String
  introduction         String?
  conclusion           String?
  authorName           String
  reviewerName         String?
  language             String                @default("en-IN")
  wordCount            Int                   @default(0)
  readingMinutes       Int                   @default(0)
  sourceCoverage       Float                 @default(0)
  originalityScore     Float                 @default(0)
  qualityScore         Float                 @default(0)
  exactHash            String
  normalizedHash       String
  minHash              String?
  simHash              BigInt?
  semanticFingerprint  String?
  generatedBy          String?
  generationPromptHash String?
  notes                String?
  createdBy            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  page                 BlogContentPage       @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  sections             BlogContentSection[]
  faqs                 BlogContentFaq[]
  fingerprints         BlogContentFingerprint[]
  leftSimilarities     BlogContentSimilarityMatch[] @relation("SimilarityLeft")
  rightSimilarities    BlogContentSimilarityMatch[] @relation("SimilarityRight")
  qualityRuns          BlogContentQualityRun[]
  reviews              BlogContentEditorialReview[]
  publications         BlogContentPublication[]

  @@unique([pageId, versionNumber])
  @@unique([exactHash])
  @@index([normalizedHash])
  @@index([pageId, status, createdAt])
  @@index([qualityScore, originalityScore])
  @@map("page_versions")
  @@schema("blog_content")
}

model BlogContentSection {
  id             String                  @id @default(cuid())
  versionId      String
  stableKey      String
  kind           BlogSectionKind
  position       Int
  heading        String?
  body           String
  bodyFormat     String                  @default("markdown")
  wordCount      Int                     @default(0)
  exactHash      String
  normalizedHash String
  origin         BlogContentOrigin
  metadata       Json                    @default("{}")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  version        BlogContentPageVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  claims         BlogContentSectionClaim[]

  @@unique([versionId, stableKey])
  @@unique([versionId, position])
  @@index([kind, normalizedHash])
  @@index([exactHash])
  @@map("sections")
  @@schema("blog_content")
}

model BlogContentSectionClaim {
  sectionId String
  claimId   String
  ordinal   Int              @default(0)
  note      String?
  section   BlogContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  claim     BlogContentClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@id([sectionId, claimId])
  @@index([claimId])
  @@map("section_claims")
  @@schema("blog_content")
}

model BlogContentFaq {
  id             String                 @id @default(cuid())
  versionId      String
  position       Int
  question       String
  answer         String
  questionHash   String
  answerHash     String
  normalizedHash String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  version        BlogContentPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, position])
  @@unique([versionId, questionHash])
  @@index([normalizedHash])
  @@map("faqs")
  @@schema("blog_content")
}

model BlogContentFingerprint {
  id          String                 @id @default(cuid())
  versionId   String
  scope       String
  scopeKey    String?
  exactHash   String
  normalizedHash String
  minHash     String?
  simHash     BigInt?
  tokenCount  Int                    @default(0)
  shingles    Int                    @default(0)
  metadata    Json                   @default("{}")
  createdAt   DateTime               @default(now())
  version     BlogContentPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, scope, scopeKey])
  @@index([scope, exactHash])
  @@index([scope, normalizedHash])
  @@map("content_fingerprints")
  @@schema("blog_content")
}

model BlogContentSimilarityMatch {
  id             String                 @id @default(cuid())
  leftVersionId  String
  rightVersionId String
  kind           BlogSimilarityKind
  scope          String
  score          Float
  threshold      Float
  blocking       Boolean                @default(false)
  details        Json                   @default("{}")
  computedAt     DateTime               @default(now())
  leftVersion    BlogContentPageVersion @relation("SimilarityLeft", fields: [leftVersionId], references: [id], onDelete: Cascade)
  rightVersion   BlogContentPageVersion @relation("SimilarityRight", fields: [rightVersionId], references: [id], onDelete: Cascade)

  @@unique([leftVersionId, rightVersionId, kind, scope])
  @@index([rightVersionId, blocking])
  @@index([kind, score])
  @@map("similarity_matches")
  @@schema("blog_content")
}

model BlogContentQualityRun {
  id          String                   @id @default(cuid())
  versionId   String
  status      BlogQualityRunStatus     @default(QUEUED)
  policyKey   String
  policyHash  String
  score       Float                    @default(0)
  blockers    Int                      @default(0)
  warnings    Int                      @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  version     BlogContentPageVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  checks      BlogContentQualityCheck[]

  @@index([versionId, status, createdAt])
  @@index([status, createdAt])
  @@map("quality_runs")
  @@schema("blog_content")
}

model BlogContentQualityCheck {
  id         String               @id @default(cuid())
  runId      String
  kind       BlogQualityCheckKind
  severity   BlogQualitySeverity
  passed     Boolean
  score      Float?
  threshold  Float?
  message    String
  details    Json                 @default("{}")
  createdAt  DateTime             @default(now())
  run        BlogContentQualityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, passed, severity])
  @@index([kind, passed])
  @@map("quality_checks")
  @@schema("blog_content")
}

model BlogContentEditorialReview {
  id          String                 @id @default(cuid())
  versionId   String
  reviewerId  String
  reviewerName String
  decision    BlogReviewDecision     @default(PENDING)
  comments    String?
  checklist   Json                   @default("{}")
  reviewedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  version     BlogContentPageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, decision])
  @@index([reviewerId, createdAt])
  @@map("editorial_reviews")
  @@schema("blog_content")
}

model BlogContentPublication {
  id             String                    @id @default(cuid())
  pageId         String
  versionId      String
  status         BlogPublicationStatus     @default(DRAFT)
  canonicalUrl   String
  indexable      Boolean                   @default(false)
  sitemapEligible Boolean                  @default(false)
  robotsDirective String                   @default("noindex,follow")
  scheduledAt    DateTime?
  publishedAt    DateTime?
  retiredAt      DateTime?
  deploymentId   String?
  failureReason  String?
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  page           BlogContentPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version        BlogContentPageVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([pageId, versionId])
  @@index([status, scheduledAt])
  @@index([indexable, sitemapEligible, status])
  @@map("publications")
  @@schema("blog_content")
}

model BlogContentRefreshJob {
  id          String                @id @default(cuid())
  workspaceId String
  pageId      String?
  sourceId    String?
  reason      String
  priority    Int                   @default(0)
  status      BlogRefreshJobStatus  @default(QUEUED)
  scheduledAt DateTime              @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  attempts    Int                   @default(0)
  lockedBy    String?
  lockedAt    DateTime?
  error       String?
  payload     Json                  @default("{}")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   BlogContentWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page        BlogContentPage?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  source      BlogContentSource?    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, priority, scheduledAt])
  @@index([workspaceId, status])
  @@index([pageId, status])
  @@index([sourceId, status])
  @@map("refresh_jobs")
  @@schema("blog_content")
}

model BlogContentAuditEvent {
  id          String                 @id @default(cuid())
  workspaceId String
  actorType   BlogAuditActorType
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  requestId   String?
  ipHash      String?
  userAgent   String?
  metadata    Json                   @default("{}")
  createdAt   DateTime               @default(now())
  workspace   BlogContentWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("audit_events")
  @@schema("blog_content")
}
