'use client';

import { useMemo, useState } from "react";

export default function MasterclassRegisterPage() {
  const [fullName, setFullName] = useState("");
  const [email, setEmail] = useState("");
  const [phone, setPhone] = useState("");
  const [laptop, setLaptop] = useState("");
  const [loading, setLoading] = useState(false);
  const [msg, setMsg] = useState<string | null>(null);

  const canSubmit = useMemo(() => {
    const p = phone.replace(/\s+/g, "");
    return fullName.trim().length >= 2 && email.trim().length >= 5 && p.length >= 10 && laptop.length > 0;
  }, [fullName, email, phone, laptop]);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    setMsg(null);
    if (!canSubmit) return;

    setLoading(true);
    try {
      // send multiple key variants for compatibility with existing API
      const payload = {
        fullName,
        name: fullName,
        email,
        phone,
        contactNumber: phone,
        laptopStatus: laptop,
        laptop,
        source: "masterclass_register_page",
        page: "/masterclass/register",
      };

      const res = await fetch("/api/masterclass/lead", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const t = await res.text().catch(() => "");
        throw new Error(`Lead API failed (${res.status}). ${t}`.trim());
      }

      // success: take user to masterclass page (or keep on same page)
      window.location.href = "/gen-ai-masterclass#register";
    } catch (err: any) {
      setMsg(err?.message || "Something went wrong");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-[calc(100vh-56px)] bg-white">
      <div className="mx-auto max-w-[1200px] px-4 py-8">
        <div className="grid grid-cols-1 overflow-hidden rounded-3xl border border-gray-200 md:grid-cols-2">
          {/* Left: dark panel */}
          <section className="relative bg-[#071423] p-10 text-white">
            <div className="absolute inset-0 opacity-[0.08] [background-image:linear-gradient(135deg,rgba(255,255,255,0.2)_25%,transparent_25%,transparent_50%,rgba(255,255,255,0.2)_50%,rgba(255,255,255,0.2)_75%,transparent_75%,transparent)] [background-size:40px_40px]" />
            <div className="relative">
              <div className="mb-10">
                <div className="text-4xl font-extrabold leading-tight">
                  Masterclass Registration
                </div>
                <p className="mt-3 max-w-md text-white/80">
                  Fill details to continue. Laptop status is required for class setup.
                </p>
              </div>

              <div className="mt-10">
                <div className="text-sm font-semibold text-white/70">Mentored By</div>
                <div className="mt-3 flex items-center gap-3">
                  <div className="h-12 w-12 rounded-full bg-white/10" />
                  <div>
                    <div className="font-semibold">Sikhadenge Team</div>
                    <div className="text-sm text-white/70">ThinkGrow Pvt. Ltd.</div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          {/* Right: form */}
          <section className="bg-white p-10">
            <form onSubmit={onSubmit} className="space-y-6">
              <div>
                <label className="block text-sm font-medium text-gray-900">
                  Full Name <span className="text-red-600">*</span>
                </label>
                <input
                  value={fullName}
                  onChange={(e) => setFullName(e.target.value)}
                  className="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-gray-400"
                  placeholder="Your name"
                  autoComplete="name"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-900">
                  Email Address <span className="text-red-600">*</span>
                </label>
                <input
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  className="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-gray-400"
                  placeholder="you@email.com"
                  autoComplete="email"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-900">
                  Contact Number <span className="text-red-600">*</span>
                </label>
                <input
                  value={phone}
                  onChange={(e) => setPhone(e.target.value)}
                  className="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-gray-400"
                  placeholder="+91 XXXXX XXXXX"
                  inputMode="tel"
                  autoComplete="tel"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-900">
                  Laptop Available? <span className="text-red-600">*</span>
                </label>
                <select
                  value={laptop}
                  onChange={(e) => setLaptop(e.target.value)}
                  className="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 outline-none focus:border-gray-400"
                >
                  <option value="" disabled>Select</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                  <option value="will_arrange_soon">Will arrange soon</option>
                </select>
              </div>

              {msg ? (
                <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                  {msg}
                </div>
              ) : null}

              <button
                type="submit"
                disabled={!canSubmit || loading}
                className="w-full rounded-2xl bg-[#071423] px-5 py-4 text-base font-semibold text-white disabled:opacity-50"
              >
                {loading ? "Submitting..." : "Next"}
              </button>

              <p className="text-xs text-gray-500">
                By continuing, you agree to our Terms of Service and Privacy Policy.
              </p>
            </form>
          </section>
        </div>
      </div>
    </main>
  );
}
