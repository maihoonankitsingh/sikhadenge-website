import { prisma } from "@/lib/prisma";
import Link from "next/link";
import { redirect } from "next/navigation";

type PageProps = {
  searchParams?: {
    phone?: string;
    name?: string;
  };
};

export const dynamic = "force-dynamic";

function safeNumber(value: string | undefined, fallback: number) {
  const n = Number(value || "");
  return Number.isFinite(n) && n >= 0 ? n : fallback;
}

export default async function GenAiMasterclassWelcomePage({
  searchParams,
}: PageProps) {
  const phone = String(searchParams?.phone || "").trim();
  const name = String(searchParams?.name || "").trim();

  const rows = await prisma.siteSetting.findMany({
    where: {
      key: {
        in: [
          "masterclass_community_link",
          "masterclass_welcome_redirect_link",
          "masterclass_welcome_redirect_delay_seconds",
        ],
      },
    },
  });

  const map = new Map(rows.map((row) => [row.key, row.value]));

  const communityLink =
    map.get("masterclass_community_link") ||
    "https://chat.whatsapp.com/H5azzOxrO4NHDvkyp6EJkt";

  const redirectLink =
    map.get("masterclass_welcome_redirect_link") ||
    communityLink;

  const redirectDelaySeconds = safeNumber(
    map.get("masterclass_welcome_redirect_delay_seconds"),
    5
  );

  if (!phone) {
    redirect("/gen-ai-masterclass/register-one-step");
  }

  return (
    <main className="min-h-screen bg-[#F8FAFC] text-slate-900">
      <section className="mx-auto flex min-h-screen max-w-4xl items-center justify-center px-4 py-10">
        <div className="w-full rounded-[32px] border border-slate-200 bg-white p-8 shadow-[0_20px_60px_rgba(2,6,23,0.08)] sm:p-10">
          <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-700">
            ✓
          </div>

          <h1 className="mt-5 text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            Registration Successful
          </h1>

          <p className="mt-4 text-center text-base leading-8 text-slate-600 sm:text-lg">
            {name ? `${name}, ` : ""}
            your seat is confirmed. You will be redirected to the WhatsApp community in{" "}
            <span className="font-semibold text-slate-900">
              {redirectDelaySeconds} second{redirectDelaySeconds === 1 ? "" : "s"}
            </span>
            .
          </p>

          <div className="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5">
            <div className="grid gap-4 sm:grid-cols-2">
              <div className="rounded-2xl bg-white p-4">
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Registered Phone
                </p>
                <p className="mt-2 text-sm font-semibold text-slate-900 break-all">
                  {phone}
                </p>
              </div>

              <div className="rounded-2xl bg-white p-4">
                <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Community Link
                </p>
                <p className="mt-2 text-sm font-semibold text-slate-900 break-all">
                  {communityLink}
                </p>
              </div>
            </div>
          </div>

          <div className="mt-6 flex flex-col gap-3 sm:flex-row">
            <Link
              href={redirectLink}
              className="inline-flex w-full items-center justify-center rounded-2xl bg-[#3267E3] px-5 py-4 text-base font-bold text-white shadow-[0_14px_34px_rgba(50,103,227,0.28)] transition hover:bg-[#2457D6]"
            >
              Join WhatsApp Community Now
            </Link>

            <Link
              href={communityLink}
              className="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-4 text-base font-bold text-slate-900 transition hover:bg-slate-50"
            >
              Open Community Link
            </Link>
          </div>

          <p className="mt-6 text-center text-sm leading-6 text-slate-500">
            Keep your WhatsApp active. Class details and important updates will be shared there.
          </p>
        </div>
      </section>

      <script
        dangerouslySetInnerHTML={{
          __html: `
            setTimeout(function () {
              window.location.href = ${JSON.stringify(redirectLink)};
            }, ${redirectDelaySeconds * 1000});
          `,
        }}
      />
    </main>
  );
}
