          margin-top: 0 !important;
          padding-top: 0 !important;
        }

        main {
          margin-top: 0 !important;
          padding-top: 0 !important;
        }
      `}</style>

      <main className="relative min-h-screen overflow-hidden bg-[#0B1220] text-white">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.16),transparent_28%),radial-gradient(circle_at_bottom_left,rgba(245,179,1,0.10),transparent_22%),linear-gradient(180deg,#0B1220_0%,#111827_100%)]" />

        <div className="absolute inset-0 opacity-[0.06] [background-image:linear-gradient(rgba(255,255,255,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.08)_1px,transparent_1px)] [background-size:56px_56px]" />

        <div className="absolute left-[-140px] top-[-140px] h-[320px] w-[320px] rounded-full bg-[rgba(37,99,235,0.18)] blur-3xl" />
        <div className="absolute bottom-[-120px] right-[-80px] h-[260px] w-[260px] rounded-full bg-[rgba(245,179,1,0.14)] blur-3xl" />

        <canvas ref={canvasRef} className="absolute inset-0 h-full w-full opacity-70" />

        <section className="relative z-10 flex min-h-screen items-start justify-center px-4 pt-2 pb-10 sm:pt-3">
          <div className="w-full max-w-[760px] rounded-[32px] border border-[rgba(255,255,255,0.10)] bg-[rgba(17,24,39,0.82)] p-8 text-center shadow-[0_0_18px_rgba(37,99,235,0.20),0_24px_80px_rgba(0,0,0,0.34)] backdrop-blur-xl sm:p-10">
            <div className="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full border border-[rgba(245,179,1,0.22)] bg-[rgba(245,179,1,0.10)] shadow-[0_0_18px_rgba(245,179,1,0.22)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="34"
                height="34"
                viewBox="0 0 24 24"
                fill="none"
                className="text-[#F5B301]"
              >
                <path
                  d="M20 7L9 18L4 13"
                  stroke="currentColor"
                  strokeWidth="2.5"
                  strokeLinecap="round"
                  strokeLinejoin="round"
                />
              </svg>
            </div>

            <div className="mb-3 inline-flex items-center gap-2 rounded-full border border-[rgba(255,255,255,0.10)] bg-[rgba(255,255,255,0.04)] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#B0B7C3]">
              Registration Confirmed
            </div>

            <h1 className="text-[42px] font-extrabold leading-none tracking-[-0.04em] text-white sm:text-[58px]">
              You&apos;re In
              <span className="block text-[#2563EB]">Sikhadenge</span>
            </h1>

            <p className="mx-auto mt-5 max-w-[520px] text-[15px] leading-7 text-[#B0B7C3] sm:text-[16px]">
              Registration complete ho gaya hai.
              <br />
              Next step ke liye WhatsApp open karein.
            </p>

            <div className="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noreferrer"
                className="inline-flex min-w-[210px] items-center justify-center rounded-2xl bg-[#2563EB] px-6 py-3.5 text-[15px] font-semibold text-white shadow-[0_0_18px_rgba(37,99,235,0.55)] transition hover:bg-[#1D4ED8]"
              >
                Continue on WhatsApp
              </a>

              <Link
                href="/"
                className="inline-flex min-w-[150px] items-center justify-center rounded-2xl border border-[rgba(255,255,255,0.12)] bg-[rgba(255,255,255,0.04)] px-6 py-3.5 text-[15px] font-semibold text-white transition hover:bg-[rgba(255,255,255,0.08)]"
              >
                Go to Home
              </Link>
            </div>

            <div className="mt-8 grid gap-3 sm:grid-cols-3">
              <div className="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] px-4 py-4">
                <p className="text-[11px] uppercase tracking-[0.16em] text-[#9CA3AF]">
                  Status
                </p>
                <p className="mt-2 text-[15px] font-semibold text-white">
                  Seat Request Saved
                </p>
              </div>

              <div className="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] px-4 py-4">
                <p className="text-[11px] uppercase tracking-[0.16em] text-[#9CA3AF]">
                  Next Step
                </p>
                <p className="mt-2 text-[15px] font-semibold text-white">
                  Join WhatsApp
                </p>
              </div>

              <div className="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] px-4 py-4">
                <p className="text-[11px] uppercase tracking-[0.16em] text-[#9CA3AF]">
                  Support
                </p>
                <p className="mt-2 text-[15px] font-semibold text-white">
                  Team Support
                </p>
              </div>
            </div>

            <p className="mt-6 text-[12px] text-[#9CA3AF]">
              5 sec baad aap automatically WhatsApp group par redirect ho jayenge.
            </p>
          

{/* WHATSAPP COMMUNITY CTA */}
<div className="mt-8 max-w-xl mx-auto text-center">

<p className="text-sm text-slate-300 mb-4">
