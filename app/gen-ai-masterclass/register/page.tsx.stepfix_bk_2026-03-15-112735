'use client';
async function waitForFbq(timeoutMs: number = 1500) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    try {
      const fbq = (window as any).fbq;
      if (typeof fbq === "function") return fbq;
    } catch {}
    await new Promise((r) => setTimeout(r, 100));
  }
  return null;
}

