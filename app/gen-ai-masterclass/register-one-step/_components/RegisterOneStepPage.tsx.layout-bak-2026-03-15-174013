'use client'

import { useEffect, useMemo, useState } from 'react'
import { useRouter } from 'next/navigation'

type FormState = {
  name: string
  email: string
  phone: string
  experience: string
  goal: string
  laptop: string
}

type SubmitState = 'idle' | 'loading' | 'success' | 'error'

const EXPERIENCE_OPTIONS = [
  'Working professional - Technical roles',
  'Working professional - Non technical',
  'College student - Final year',
  'College student - 1st to pre-final year',
  'Others',
]

const GOAL_OPTIONS = [
  'Career Transition',
  'Job Upgrade',
  'Freelancing',
  'Skill Building',
  'Business Growth',
]

export default function RegisterOneStepPage() {
  const router = useRouter()
  const [search, setSearch] = useState('')

  useEffect(() => {
    if (typeof window !== 'undefined') {
      setSearch(window.location.search || '')
    }
  }, [])

  const [form, setForm] = useState<FormState>({
    name: '',
    email: '',
    phone: '',
    experience: EXPERIENCE_OPTIONS[0],
    goal: GOAL_OPTIONS[0],
    laptop: 'true',
  })

  const [errors, setErrors] = useState<Partial<Record<keyof FormState, string>>>({})
  const [submitState, setSubmitState] = useState<SubmitState>('idle')
  const [submitError, setSubmitError] = useState('')

  const tracking = useMemo(() => {
    const params = new URLSearchParams(search)
    const get = (key: string) => params.get(key) || ''

    const landingUrl =
      typeof window !== 'undefined' ? window.location.href : ''

    const referrer =
      typeof document !== 'undefined' ? document.referrer : ''

    return {
      utm_source: get('utm_source'),
      utm_medium: get('utm_medium'),
      utm_campaign: get('utm_campaign'),
      utm_term: get('utm_term'),
      utm_content: get('utm_content'),
      utm_id: get('utm_id'),
      utm_campaign_id: get('utm_campaign_id') || get('campaign_id'),
      utm_adset_id: get('utm_adset_id') || get('adset_id'),
      utm_ad_id: get('utm_ad_id') || get('ad_id'),
      fbclid: get('fbclid'),
      gclid: get('gclid'),
      msclkid: get('msclkid'),
      landingUrl,
      referrer,
      page: '/gen-ai-masterclass/register-one-step',
      source: 'website',
      attribution: {
        fbclid: get('fbclid'),
        gclid: get('gclid'),
        msclkid: get('msclkid'),
        referrer,
        landingUrl,
      },
    }
  }, [search])

  function setField<K extends keyof FormState>(key: K, value: FormState[K]) {
    setForm((prev) => ({ ...prev, [key]: value }))
    setErrors((prev) => ({ ...prev, [key]: '' }))
  }

  function validate() {
    const nextErrors: Partial<Record<keyof FormState, string>> = {}

    if (!form.name.trim()) nextErrors.name = 'Name is required'
    if (!form.email.trim()) {
      nextErrors.email = 'Email is required'
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.email.trim())) {
      nextErrors.email = 'Enter a valid email'
    }

    const phoneDigits = form.phone.replace(/\D/g, '')
    if (!phoneDigits) {
      nextErrors.phone = 'Phone number is required'
    } else if (phoneDigits.length < 10) {
      nextErrors.phone = 'Enter a valid phone number'
    }

    if (!form.experience.trim()) nextErrors.experience = 'Experience is required'
    if (!form.goal.trim()) nextErrors.goal = 'Goal is required'
    if (!form.laptop.trim()) nextErrors.laptop = 'Laptop selection is required'

    setErrors(nextErrors)
    return Object.keys(nextErrors).length === 0
  }

  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault()
    setSubmitError('')

    if (!validate()) return

    setSubmitState('loading')

    const payload = {
      name: form.name.trim(),
      email: form.email.trim(),
      phone: form.phone.replace(/\D/g, ''),
      experience: form.experience,
      goal: form.goal,
      laptop: form.laptop === 'true',
      source: tracking.source,
      page: tracking.page,
      utm_source: tracking.utm_source || null,
      utm_medium: tracking.utm_medium || null,
      utm_campaign: tracking.utm_campaign || null,
      utm_term: tracking.utm_term || null,
      utm_content: tracking.utm_content || null,
      utm_id: tracking.utm_id || null,
      utm_campaign_id: tracking.utm_campaign_id || null,
      utm_adset_id: tracking.utm_adset_id || null,
      utm_ad_id: tracking.utm_ad_id || null,
      fbclid: tracking.fbclid || null,
      gclid: tracking.gclid || null,
      msclkid: tracking.msclkid || null,
      landingUrl: tracking.landingUrl || null,
      referrer: tracking.referrer || null,
      attribution: tracking.attribution,
    }

    try {
      const res = await fetch('/api/masterclass-lead', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      })

      if (!res.ok) {
        let message = 'Submission failed'
        try {
          const data = await res.json()
          if (data?.error) message = data.error
        } catch {}
        throw new Error(message)
      }

      setSubmitState('success')

      const qs = new URLSearchParams()
      if (tracking.utm_source) qs.set('utm_source', tracking.utm_source)
      if (tracking.utm_medium) qs.set('utm_medium', tracking.utm_medium)
      if (tracking.utm_campaign) qs.set('utm_campaign', tracking.utm_campaign)
      if (tracking.utm_term) qs.set('utm_term', tracking.utm_term)
      if (tracking.utm_content) qs.set('utm_content', tracking.utm_content)
      if (tracking.utm_campaign_id) qs.set('utm_campaign_id', tracking.utm_campaign_id)
      if (tracking.utm_adset_id) qs.set('utm_adset_id', tracking.utm_adset_id)
      if (tracking.utm_ad_id) qs.set('utm_ad_id', tracking.utm_ad_id)
      if (tracking.fbclid) qs.set('fbclid', tracking.fbclid)

      const query = qs.toString()
      router.push(query ? `/gen-ai-masterclass/welcome?${query}` : '/gen-ai-masterclass/welcome')
    } catch (error) {
      setSubmitState('error')
      setSubmitError(error instanceof Error ? error.message : 'Something went wrong')
    }
  }

  return (
    <main className="min-h-screen bg-[#F8FAFC] text-[#0F172A]">
      <section className="mx-auto grid min-h-screen max-w-7xl gap-10 px-4 py-8 md:px-6 lg:grid-cols-[0.94fr_1fr] lg:items-center lg:px-8">
        <div className="order-2 lg:order-1">
          <div className="inline-flex items-center rounded-full border border-[rgba(37,99,235,0.14)] bg-white px-3 py-1.5 text-[11px] font-medium text-[#2563EB] shadow-[0_8px_18px_rgba(15,23,42,0.05)]">
            ✦ Free Live Masterclass
          </div>

          <h1 style={{ maxWidth: "12ch", letterSpacing: "-0.035em", lineHeight: "1.02" }} className="mt-4 max-w-[420px] text-[20px] font-semibold tracking-[-0.02em] leading-[1.14] text-[#0F172A] md:text-[26px] lg:text-[30px]">
            Become an <span className="text-[#2563EB]">AI Generalist</span> with practical,
            job-relevant digital execution skills
          </h1>

          <p className="mt-2 max-w-[400px] text-[11px] leading-[1.7] text-slate-600 md:text-[12px]">
            Learn how AI-powered workflows are used across design, content,
            video, marketing, landing pages, and execution.
          </p>

          <div className="mt-4 grid max-w-[500px] gap-2 sm:grid-cols-3">
            <div className="flex items-center gap-2 rounded-[14px] border border-slate-200 bg-white px-3 py-2 text-[11px] text-slate-700 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
              <span className="text-[13px]">⚡</span>
              <span>AI-first practical workflow</span>
            </div>
            <div className="flex items-center gap-2 rounded-[14px] border border-slate-200 bg-white px-3 py-2 text-[11px] text-slate-700 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
              <span className="text-[13px]">🎯</span>
              <span>Job and freelancing oriented</span>
            </div>
            <div className="flex items-center gap-2 rounded-[14px] border border-slate-200 bg-white px-3 py-2 text-[11px] text-slate-700 shadow-[0_4px_12px_rgba(15,23,42,0.04)]">
              <span className="text-[13px]">🧩</span>
              <span>Structured digital execution</span>
            </div>
          </div>

            <div className="rounded-full border border-slate-200 bg-white px-4 py-3 text-[14px] font-medium text-slate-700 shadow-[0_4px_14px_rgba(15,23,42,0.04)]">
              <span>🚀</span>
              <span className="ml-2">Clear skill-building path</span>
            </div>

          <div className="mt-4 grid max-w-[500px] grid-cols-3 gap-2.5">
            <div className="rounded-[16px] border border-slate-200 bg-white p-3 shadow-[0_8px_18px_rgba(15,23,42,0.04)]">
              <div className="text-[24px] font-semibold leading-none text-[#0F172A]">100%</div>
              <div className="mt-1 text-[11px] leading-4 text-slate-500">Live classes</div>
            </div>
            <div className="rounded-[16px] border border-slate-200 bg-white p-3 shadow-[0_8px_18px_rgba(15,23,42,0.04)]">
              <div className="text-[24px] font-semibold leading-none text-[#0F172A]">1200+</div>
              <div className="mt-1 text-[11px] leading-4 text-slate-500">Companies hiring</div>
            </div>
            <div className="rounded-[16px] border border-slate-200 bg-white p-3 shadow-[0_8px_18px_rgba(15,23,42,0.04)]">
              <div className="text-[24px] font-semibold leading-none text-[#0F172A]">95%</div>
              <div className="mt-1 text-[11px] leading-4 text-slate-500">Execution focus</div>
            </div>

            <div className="rounded-[20px] border border-slate-200 bg-white p-4 shadow-[0_6px_20px_rgba(15,23,42,0.04)]">
              <div className="text-[24px] font-semibold leading-none text-[#0F172A]">1.5L+</div>
              <div className="mt-1 text-[11px] leading-4 text-slate-500">Learner interest</div>
            </div>
          </div>

            <div className="mt-8 rounded-[28px] border border-slate-200 bg-white p-5 shadow-[0_12px_32px_rgba(15,23,42,0.05)] md:p-6">
              <div className="mb-4 text-[13px] font-semibold uppercase tracking-[0.28em] text-[#2563EB]">
                What You Will Understand
              </div>

              <div className="grid gap-4 md:grid-cols-2">
                {[
                  "AI Generalist positioning in current market",
                  "How to build practical output-based capability",
                  "Which digital execution skills matter now",
                  "How learners can move toward jobs and freelancing",
                ].map((item) => (
                  <div
                    key={item}
                    className="rounded-[20px] border border-slate-200 bg-slate-50 px-5 py-5 text-[18px] leading-8 text-slate-800"
                  >
                    {item}
                  </div>
                ))}
              </div>
            </div>

        </div>

        <div className="order-1 lg:order-2">
          <div className="mx-auto w-full max-w-[520px] rounded-[24px] border border-slate-200 bg-white p-5 text-[#0F172A] shadow-[0_18px_40px_rgba(15,23,42,0.08)] md:p-6">
            <div className="text-[28px] font-semibold leading-snug md:text-[30px]">
              Register for the <span className="text-[#2563EB]">free live</span>{' '}
              masterclass
            </div>

            <p className="mt-1.5 text-[11px] leading-4 text-slate-600 md:text-xs">
              Fill once. Submit once. Direct registration on the same page.
            </p>

            <form className="mt-5 space-y-3" onSubmit={handleSubmit} noValidate>
              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Name <span className="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  value={form.name}
                  onChange={(e) => setField('name', e.target.value)}
                  placeholder="Enter name"
                  className={`w-full rounded-lg border px-3 py-2 text-[13px] outline-none transition ${
                    errors.name
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100'
                  }`}
                />
                {errors.name ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.name}</p>
                ) : null}
              </div>

              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Email <span className="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  value={form.email}
                  onChange={(e) => setField('email', e.target.value)}
                  placeholder="Email"
                  className={`w-full rounded-lg border px-3 py-2 text-[13px] outline-none transition ${
                    errors.email
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100'
                  }`}
                />
                {errors.email ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.email}</p>
                ) : null}
              </div>

              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Phone Number <span className="text-red-500">*</span>
                </label>
                <div
                  className={`flex items-center overflow-hidden rounded-lg border ${
                    errors.phone
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus-within:border-[#2563EB] focus-within:ring-2 focus-within:ring-blue-100'
                  }`}
                >
                  <div className="border-r border-slate-200 px-2.5 py-2 text-[13px] text-slate-700">
                    🇮🇳 +91
                  </div>
                  <input
                    type="tel"
                    value={form.phone}
                    onChange={(e) => setField('phone', e.target.value)}
                    placeholder="Phone number"
                    className="w-full px-3 py-2 text-[13px] outline-none"
                  />
                </div>
                {errors.phone ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.phone}</p>
                ) : null}
              </div>
              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Experience <span className="text-red-500">*</span>
                </label>
                <select
                  value={form.experience}
                  onChange={(e) => setField('experience', e.target.value)}
                  className={`w-full rounded-lg border px-3 py-2 text-[13px] outline-none transition ${
                    errors.experience
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100'
                  }`}
                >
                  {EXPERIENCE_OPTIONS.map((item) => (
                    <option key={item} value={item}>
                      {item}
                    </option>
                  ))}
                </select>
                {errors.experience ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.experience}</p>
                ) : null}
              </div>

              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Goal <span className="text-red-500">*</span>
                </label>
                <select
                  value={form.goal}
                  onChange={(e) => setField('goal', e.target.value)}
                  className={`w-full rounded-lg border px-3 py-2 text-[13px] outline-none transition ${
                    errors.goal
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100'
                  }`}
                >
                  {GOAL_OPTIONS.map((item) => (
                    <option key={item} value={item}>
                      {item}
                    </option>
                  ))}
                </select>
                {errors.goal ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.goal}</p>
                ) : null}
              </div>
              <div>
                <label className="mb-1 block text-[12px] font-medium text-slate-700">
                  Do you have a laptop? <span className="text-red-500">*</span>
                </label>
                <select
                  value={form.laptop}
                  onChange={(e) => setField('laptop', e.target.value)}
                  className={`w-full rounded-lg border px-3 py-2 text-[13px] outline-none transition ${
                    errors.laptop
                      ? 'border-red-400 ring-2 ring-red-100'
                      : 'border-slate-300 focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100'
                  }`}
                >
                  <option value="true">Yes</option>
                  <option value="false">No</option>
                </select>
                {errors.laptop ? (
                  <p className="mt-1 text-[11px] text-red-500">{errors.laptop}</p>
                ) : null}
              </div>

              <button
                type="submit"
                disabled={submitState === 'loading'}
                className="w-full rounded-lg bg-[#2563EB] px-4 py-2.5 text-[13px] font-semibold text-white transition hover:bg-[#1D4ED8] disabled:cursor-not-allowed disabled:opacity-70"
              >
                {submitState === 'loading' ? 'Registering...' : 'Register Now'}
              </button>

              {submitState === 'error' && submitError ? (
                <div className="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[12px] text-red-600">
                  {submitError}
                </div>
              ) : null}

              <p className="text-[10px] leading-4 text-slate-500">
                By continuing, you agree to receive communication related to
                masterclass updates and registration details.
              </p>
            </form>
          </div>
        </div>
      </section>
    </main>
  )
}
