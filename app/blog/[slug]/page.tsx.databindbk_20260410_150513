type BlogItem = {
  slug: string;
  title: string;
  excerpt?: string;
  category?: string;
  readTime?: string;
};

function getBlogs(): BlogItem[] {
  try {
    const filePath = path.join(process.cwd(), "data/blogs.json");
    return JSON.parse(fs.readFileSync(filePath, "utf8"));
  } catch {
    return [];
  }
}

function formatTitle(slug: string) {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function normalizeText(value?: string) {
  return (value || "").toLowerCase().trim();
}

function tokenize(value?: string) {
  return normalizeText(value)
    .replace(/[^a-z0-9\s-]/g, " ")
    .split(/\s+/)
    .filter(Boolean);
}

function getRelatedBlogs(all: BlogItem[], current: BlogItem) {
  const currentTitle = new Set(tokenize(current.title));
  const currentCategory = normalizeText(current.category);

  return all
    .filter((item) => item.slug !== current.slug)
    .map((item) => {
      let score = 0;

      tokenize(item.title).forEach((token) => {
        if (currentTitle.has(token)) score += 3;
      });

      if (normalizeText(item.category) === currentCategory) score += 4;

      return { item, score };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 6)
    .map((entry) => entry.item);
}

export async function generateStaticParams() {
  return getBlogs().map((post) => ({ slug: post.slug }));
}

export const dynamicParams = true;
export const revalidate = 2592000;

export function generateMetadata({ params }: { params: { slug: string } }) {
  const blogs = getBlogs();
  const post = blogs.find((item) => item.slug === params.slug);

  if (!post) {
    return { title: "Blog | Sikhadenge" };
  }

  return {
    title: `${post.title} | Sikhadenge`,
    description:
      post.excerpt ||
      `Read this practical guide on ${post.title} with simple explanations, real use cases, and execution-focused learning.`,
    alternates: {
      canonical: `https://sikhadenge.in/blog/${post.slug}`,
    },
    openGraph: {
      title: `${post.title} | Sikhadenge`,
      description:
        post.excerpt ||
        `Read this practical guide on ${post.title} with simple explanations, real use cases, and execution-focused learning.`,
      url: `https://sikhadenge.in/blog/${post.slug}`,
      type: "article",
    },
  };
}

