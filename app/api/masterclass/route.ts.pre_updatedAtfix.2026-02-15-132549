import { NextResponse } from "next/server";
import { PrismaClient, Prisma } from "@prisma/client";

const prisma = new PrismaClient();

function pick(v: any): string {
  if (v == null) return "";
  return String(v).trim();
}

function buildPublicBase(req: Request) {
  const h = req.headers;
  const proto = (h.get("x-forwarded-proto") || "https").split(",")[0].trim();
  const host = (h.get("x-forwarded-host") || h.get("host") || "").split(",")[0].trim();
  return `${proto}://${host}`;
}

function hasModelField(modelName: string, fieldName: string): boolean {
  const m = Prisma.dmmf.datamodel.models.find((x) => x.name === modelName);
  return !!m?.fields?.some((f) => f.name === fieldName);
}

async function pushToNeodove(payload: any) {
  const endpoint = process.env.NEODOVE_MASTERCLASS_ENDPOINT || process.env.NEODOVE_ENDPOINT || "";
  if (!endpoint) return;

  try {
    const r = await fetch(endpoint, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    console.log("NEODOVE_PAYLOAD", JSON.stringify(payload));
    console.log("NEODOVE_PUSH_OK", r.status);
  } catch (e) {
    console.error("NEODOVE_PUSH_FAIL", e);
  }
}

export async function POST(req: Request) {
  try {
    const ct = (req.headers.get("content-type") || "").toLowerCase();

    let name = "";
    let phone = "";
    let email = "";
    let source: string | null = null;
    let page: string | null = null;

    if (ct.includes("application/json")) {
      const body: any = await req.json();
      name = pick(body?.name);
      phone = pick(body?.phone || body?.mobile);
      email = pick(body?.email);
      source = pick(body?.source) || null;
      page = pick(body?.page) || null;
    } else if (ct.includes("application/x-www-form-urlencoded") || ct.includes("multipart/form-data")) {
      const form = await req.formData();
      name = pick(form.get("name"));
      phone = pick(form.get("phone") || form.get("mobile"));
      email = pick(form.get("email"));
      source = pick(form.get("source")) || null;
      page = pick(form.get("page")) || null;
    } else {
      const text = await req.text();
      const p = new URLSearchParams(text);
      name = pick(p.get("name"));
      phone = pick(p.get("phone") || p.get("mobile"));
      email = pick(p.get("email"));
      source = pick(p.get("source")) || null;
      page = pick(p.get("page")) || null;
    }

    if (!name || !phone || !email) {
      return NextResponse.json({ ok: false, error: "missing_fields" }, { status: 400 });
    }

    phone = phone.replace(/\D/g, "");
    if (phone.length > 10) phone = phone.slice(-10);

    const createData: any = {
      id: (globalThis.crypto?.randomUUID?.() ?? `${Date.now()}`),
      name,
      phone,
      email,
      source,
      page,
    };

    // if schema has these fields, set them (avoids Prisma validation error + avoids unknown-arg error)
    if (hasModelField("MasterclassLead", "updatedAt")) createData.updatedAt = new Date();
    if (hasModelField("MasterclassLead", "createdAt")) createData.createdAt = new Date();

    await prisma.masterclassLead.upsert({
      where: { phone },
      update: {
        name,
        email,
        source,
        page,
        ...(hasModelField("MasterclassLead", "updatedAt") ? ({ updatedAt: new Date() } as any) : {}),
      },
      create: {
        id: (globalThis.crypto?.randomUUID?.() ?? String(Date.now())),
        name, phone, email, source, page,
      },
    });

    await pushToNeodove({
      name,
      mobile: phone,
      email,
      detail1: `source=${source ?? ""}`,
      detail2: `page=${page ?? ""}`,
    });

    const url = new URL("/masterclass?ok=1", buildPublicBase(req));
    return NextResponse.redirect(url, 303);
  } catch (e) {
    console.error("masterclass api error:", e);
    return NextResponse.json({ ok: false, error: "server_error" }, { status: 500 });
  }
}
