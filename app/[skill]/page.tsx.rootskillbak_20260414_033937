export function generateMetadata({ params }: { params: { skill: string } }) {
  const rootSkill = skillsData.find((s) => s.slug === params.skill);
  if (rootSkill) return { title: `How to Become a ${rootSkill.title} | Sikhadenge`, description: rootSkill.description };
  const seoData = getGeneratedSeoData();
  const generatedPage = seoData.find((s: any) => s.slug === params.skill);
  if (generatedPage) return { title: generatedPage.title, description: generatedPage.description };
  return { title: "Page Not Found" };
}

function shuffleArray(array: any[]) {
  const shiffted = [...array];
  for (let i = shiffted.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shiffted[i], shiffted[j]] = [shiffted[j], shiffted[i]];
  }
  return shiffted;
}

