  // click/tap: play ONE with sound, keep others muted/paused
  const onCardClick = (id: string) => {
    const v = videoRefs.current[id];
    if (!v) return;

    const isActive = activeId === id;

    if (isActive) {
      setActiveId(null);
      // back to preview: first card muted autoplay
      const first = videoRefs.current["rv-0"];
      pauseAllExcept("rv-0");
      if (first) {
        first.muted = true;
        first.play().catch(() => {});
      }
      return;
    }

    pauseAllExcept(id);
    v.muted = false;
    v.volume = 1;
    v.play().catch(() => {});
    setActiveId(id);
  };

  // initial preview autoplay for first video (muted)
  useEffect(() => {
    const first = videoRefs.current["rv-0"];
    if (!first) return;
    first.muted = true;
    first.play().catch(() => {});
  }, []);

  // SD_RV_AUTOSCROLL_CLEAN_V1
  // Auto-scroll BOTH rows (video + text). Manual finger/trackpad scroll remains ON.
  useEffect(() => {
    const rv = rvScrollRef.current;
    const tr = trScrollRef.current;
    if (!rv && !tr) return;

    const reduced = typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return;

    let raf = 0;
    let last = performance.now();
    let pausedUntil = 0;

    const pause = (ms: number = 2500) => { pausedUntil = performance.now() + ms; };

    const attachPauseListeners = (el: HTMLDivElement) => {
      const onWheel = () => pause();
      const onTouch = () => pause();
      const onPointer = () => pause();
      const onEnter = () => pause();

      el.addEventListener("wheel", onWheel, { passive: true });
      el.addEventListener("touchstart", onTouch, { passive: true });
      el.addEventListener("pointerdown", onPointer, { passive: true });
      el.addEventListener("mouseenter", onEnter, { passive: true });

      return () => {
        el.removeEventListener("wheel", onWheel as any);
        el.removeEventListener("touchstart", onTouch as any);
        el.removeEventListener("pointerdown", onPointer as any);
        el.removeEventListener("mouseenter", onEnter as any);
      };
    };

    const cleanups: Array<() => void> = [];
    if (rv) cleanups.push(attachPauseListeners(rv));
    if (tr) cleanups.push(attachPauseListeners(tr));

    const tick = (t: number) => {
      const dt = t - last;
      last = t;

      if (t > pausedUntil) {
        // video row speed
        if (rv) {
          rv.scrollLeft += dt * 0.28; // px/ms
          const max = rv.scrollWidth - rv.clientWidth;
          if (max > 0 && rv.scrollLeft >= max - 1) rv.scrollLeft = 0;
        }

        // text row speed (slightly slower)
        if (tr) {
          tr.scrollLeft += dt * 0.20; // px/ms
          const max = tr.scrollWidth - tr.clientWidth;
          if (max > 0 && tr.scrollLeft >= max - 1) tr.scrollLeft = 0;
        }
      }

      raf = requestAnimationFrame(tick);
    };

    raf = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(raf);
      cleanups.forEach((fn) => { try { fn(); } catch {} });
    };
  }, []);

  return (
    <section className="mt-14" aria-label="Reviews">
      <div className="max-w-6xl mx-auto px-4">
        {/* Center heading exactly above videos */}
        <div className="text-center">
          <h2 className="text-2xl md:text-4xl font-semibold text-white">
            Success Stories of our learners
          </h2>
          <div className="mx-auto mt-3 h-[2px] w-24 bg-white/20" />
          <p className="mt-3 text-sm md:text-base text-[#B0B7C3]">
            Short video feedback (reels format).
          </p>
        </div>

        <div className="mt-6 border border-[rgba(255,255,255,0.10)] rounded-2xl bg-[#0B1220]">
          <div className="px-4 py-4">
            <div
              id="sd-rv-scroll"
              ref={rvScrollRef}
              className="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory sd-home-scrollbar-hide pr-4"
            >
              {items.map((v, idx) => {
                const id = `rv-${idx}`;
                const isOn = activeId === id;
                return (
                  <button
                    key={id}
                    type="button"
                    onClick={() => onCardClick(id)}
                    className="sd-rv-phone snap-start text-left"
                    aria-label="Play review video"
                  >
                    <div className="sd-rv-phone__inner">
                      <div className="sd-rv-videoFrame">
                        <video
                          ref={(el) => { videoRefs.current[id] = el; }}
                          className="sd-rv-videoEl"
                          src={v.src}
                          muted={!isOn}
                          playsInline
                          loop
                          autoPlay={false}
                          preload="metadata"
                          onPlay={() => pauseAllExcept(id)}
                        />
                        <div className="sd-rv-overlay">
                          <div className="sd-home-play">
                            <span className="sd-home-play__tri" />
                          </div>
                        </div>
                        <div className="sd-rv-pill">{isOn ? "Sound: ON" : "Tap to Play"}</div>
                      </div>
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          <div className="border-t border-white/10" />

          <div className="px-4 py-4">
            <div className="text-sm font-semibold text-white">Text Reviews</div>
            <div
              id="sd-tr-scroll"
              ref={trScrollRef}
              className="mt-3 flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory sd-home-scrollbar-hide pr-4"
            >
              {textList.map((r, idx) => (
                <div
                  key={`tr-${idx}`}
                  className="sd-card shrink-0 w-[280px] md:w-[340px] snap-start border border-white/10 bg-white/5 rounded-2xl p-4"
                >
                  <div className="text-sm font-semibold text-white">{r.name}</div>
                  <div className="text-xs text-[#B0B7C3]">{r.role}</div>
                  <div className="mt-3 text-sm text-[#B0B7C3] leading-relaxed">{r.text}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}

