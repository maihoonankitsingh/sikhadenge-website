  city: string;
  industry: string;
};

type PageProps = {
  params: { slug: string };
};

function toTitleCase(value: string) {
  return String(value || "")
    .split(/[\s-]+/)
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

function getPageData(slug: string): PageData | undefined {
  return (generatedPages as PageData[]).find((page) => page.slug === slug);
}

function makeWhatsappUrl(pageData: PageData) {
  const text = `Hi, mujhe ${toTitleCase(pageData.skill)} ke bare me guidance chahiye for ${toTitleCase(
    pageData.industry
  )} in ${toTitleCase(pageData.city)}. Please details share kijiye.`;

  return `https://wa.me/918808505575?text=${encodeURIComponent(text)}`;
}

export const revalidate = 2592000;


export async function generateMetadata({ params }: PageProps): Promise<Metadata> {
  const pageData = getPageData(params.slug);

  if (!pageData) {
    return {
      title: "Expert Page | Sikhadenge",
    };
  }

  const skill = toTitleCase(pageData.skill);
  const industry = toTitleCase(pageData.industry);
  const city = toTitleCase(pageData.city);
  const canonical = `https://sikhadenge.in/expert/${pageData.slug}`;

  return {
    title: `${skill} for ${industry} in ${city} | Sikhadenge`,
    description: `Learn how ${skill} is used for ${industry} in ${city}. Explore practical scope, real use cases, execution value, learning direction, and growth opportunities with Sikhadenge.`,
    alternates: {
      canonical,
    },
  };
}

