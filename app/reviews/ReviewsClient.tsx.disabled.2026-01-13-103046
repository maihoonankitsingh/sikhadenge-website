function useAutoMarquee(
  ref: React.RefObject<HTMLDivElement>,
  opts: {
    speed?: number; // px per frame
    enabled?: boolean;
    pauseOnHover?: boolean;
  } = {}
) {
  const { speed = 0.45, enabled = true, pauseOnHover = true } = opts;

  const pausedRef = useRef(false);
  const rafRef = useRef<number | null>(null);
  const resumeTimerRef = useRef<number | null>(null);

  const pause = () => {
    pausedRef.current = true;
    if (resumeTimerRef.current) window.clearTimeout(resumeTimerRef.current);
  };

  const resumeSoon = (ms = 1200) => {
    if (resumeTimerRef.current) window.clearTimeout(resumeTimerRef.current);
    resumeTimerRef.current = window.setTimeout(() => {
      pausedRef.current = false;
    }, ms);
  };

  useEffect(() => {
    const el = ref.current;
    if (!el) return;

    // Pause on user interaction (mobile + desktop)
    const onPointerDown = () => {
      pause();
      resumeSoon(1800);
    };
    const onWheel = () => {
      pause();
      resumeSoon(1800);
    };
    const onTouchStart = () => {
      pause();
      resumeSoon(2000);
    };
    const onTouchMove = () => {
      pause();
      resumeSoon(2000);
    };

    el.addEventListener("pointerdown", onPointerDown, { passive: true });
    el.addEventListener("wheel", onWheel, { passive: true });
    el.addEventListener("touchstart", onTouchStart, { passive: true });
    el.addEventListener("touchmove", onTouchMove, { passive: true });

    let onEnter: (() => void) | null = null;
    let onLeave: (() => void) | null = null;

    if (pauseOnHover) {
      onEnter = () => pause();
      onLeave = () => {
        pausedRef.current = false;
      };
      el.addEventListener("mouseenter", onEnter);
      el.addEventListener("mouseleave", onLeave);
    }

    return () => {
      el.removeEventListener("pointerdown", onPointerDown as any);
      el.removeEventListener("wheel", onWheel as any);
      el.removeEventListener("touchstart", onTouchStart as any);
      el.removeEventListener("touchmove", onTouchMove as any);
      if (onEnter) el.removeEventListener("mouseenter", onEnter);
      if (onLeave) el.removeEventListener("mouseleave", onLeave);
      if (resumeTimerRef.current) window.clearTimeout(resumeTimerRef.current);
    };
  }, [ref, pauseOnHover]);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    if (!enabled) return;

    const tick = () => {
      const node = ref.current;
      if (!node) return;

      // Need duplicated content for seamless loop:
      const half = node.scrollWidth / 2;
      if (!pausedRef.current) {
        node.scrollLeft += speed;
        if (node.scrollLeft >= half) node.scrollLeft -= half;
      }
      rafRef.current = requestAnimationFrame(tick);
    };

    rafRef.current = requestAnimationFrame(tick);

    return () => {
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
      rafRef.current = null;
    };
  }, [ref, enabled, speed]);

  return { pause, resumeSoon };
}

