type RingTone = "blue" | "gold";

function cn(...classes: Array<string | false | undefined>) {
  return classes.filter(Boolean).join(" ");
}

function Container({ children }: { children: React.ReactNode }) {
  return (
    <div className="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">{children}</div>
  );
}

function Card({
  children,
  className,
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <div
      className={cn(
        "rounded-2xl border border-white/10 bg-[#111827]",
        className
      )}
    >
      {children}
    </div>
  );
}

function Pill({ children }: { children: React.ReactNode }) {
  return (
    <span className="inline-flex items-center rounded-full border border-white/10 bg-[#0B1220] px-3 py-1 text-xs font-medium text-[#B0B7C3]">
      {children}
    </span>
  );
}

/** Neon ring style (allowed glows only). Bigger icons. */
function RingIcon({
  tone,
  icon: Icon,
  size = "md",
}: {
  tone: RingTone;
  icon: React.ElementType;
  size?: "sm" | "md";
}) {
  const ring = size === "sm" ? "h-11 w-11" : "h-14 w-14";
  const icon = size === "sm" ? "h-5 w-5" : "h-7 w-7";

  const toneClass =
    tone === "gold"
      ? "text-[#F5B301] shadow-[0_0_18px_rgba(245,179,1,0.55)]"
      : "text-[#2563EB] shadow-[0_0_18px_rgba(37,99,235,0.55)]";

  return (
    <span
      className={cn(
        "flex items-center justify-center rounded-full border border-white/10 bg-[#111827]",
        ring,
        toneClass
      )}
      aria-hidden="true"
    >
      <Icon className={cn(icon)} strokeWidth={2} />
    </span>
  );
}

/** Image + bottom info card (like your sample). */
function ImageWithBottomCard({
  src,
  alt,
  topPill,
  bottomIcon,
  bottomTone,
  bottomTitle,
  bottomDesc,
  priority,
}: {
  src: string;
  alt: string;
  topPill?: string;
  bottomIcon: React.ElementType;
  bottomTone: RingTone;
  bottomTitle: string;
  bottomDesc: string;
  priority?: boolean;
}) {
  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-[#111827]">
      <div className="relative h-[260px] sm:h-[320px] lg:h-[520px]">
        <Image
          src={src}
          alt={alt}
          fill
          priority={priority}
          sizes="(max-width: 1024px) 100vw, 520px"
          className="object-cover"
        />
        {topPill ? (
          <div className="absolute left-4 top-4">
            <Pill>{topPill}</Pill>
          </div>
        ) : null}
      </div>

      <div className="p-4 sm:p-5">
        <div className="rounded-2xl border border-white/10 bg-[#0B1220] px-5 py-5">
          <div className="flex items-start gap-4">
            <RingIcon tone={bottomTone} icon={bottomIcon} />
            <div>
              <div className="text-base font-semibold text-white">
                {bottomTitle}
              </div>
              <div className="mt-1 text-sm leading-6 text-[#B0B7C3]">
                {bottomDesc}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

function SectionHead({ title, desc }: { title: string; desc?: string }) {
