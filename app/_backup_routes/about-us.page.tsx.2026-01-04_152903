type IconType = ComponentType<{ className?: string; style?: CSSProperties }>;

function IconBubble({
  icon: Icon,
  tone = "blue",
  size = 44,
  iconSize = 18,
}: {
  icon: IconType;
  tone?: "blue" | "gold";
  size?: number;
  iconSize?: number;
}) {
  const glow =
    tone === "blue"
      ? "shadow-[0_0_18px_rgba(37,99,235,0.55)]"
      : "shadow-[0_0_18px_rgba(245,179,1,0.55)]";

  const ring =
    tone === "blue"
      ? "ring-[#2563EB]/25 border-[#2563EB]/25"
      : "ring-[#F5B301]/25 border-[#F5B301]/25";

  const iconColor = tone === "blue" ? "text-[#2563EB]" : "text-[#F5B301]";

  return (
    <span
      className={[
        "relative shrink-0 inline-flex items-center justify-center rounded-full overflow-hidden",
        "bg-white/[0.04] border",
        "ring-1",
        ring,
        glow,
      ].join(" ")}
      style={{ width: size, height: size, minWidth: size, minHeight: size }}
      aria-hidden="true"
    >
      <span
        className={[
          "absolute inset-0 rounded-full",
          tone === "blue"
            ? "bg-[radial-gradient(circle_at_30%_30%,rgba(37,99,235,0.25),transparent_55%)]"
            : "bg-[radial-gradient(circle_at_30%_30%,rgba(245,179,1,0.20),transparent_55%)]",
        ].join(" ")}
      />
      <Icon
        className={["relative", iconColor].join(" ")}
        style={{ width: iconSize, height: iconSize }}
      />
    </span>
  );
}

function SectionShell({
