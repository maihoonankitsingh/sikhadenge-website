function ImageFrame({
  src,
  alt,
  label,
  overlayTitle,
  overlayDesc,
  overlayTone = "blue",
  aspect = "16/9",
  objectPosition = "center",
}: {
  src: string;
  alt: string;
  label: string;
  overlayTitle?: string;
  overlayDesc?: string;
  overlayTone?: "blue" | "gold";
  aspect?: "16/9" | "4/3" | "3/2";
  objectPosition?: string;
}) {
  const aspectClass =
    aspect === "4/3"
      ? "aspect-[4/3]"
      : aspect === "3/2"
      ? "aspect-[3/2]"
      : "aspect-[16/9]";

  return (
    <div className="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0B1220]/50 shadow-[0_0_24px_rgba(0,0,0,0.25)]">
      <div className="absolute left-4 top-4 z-10">
        <span className="inline-flex items-center rounded-full bg-black/45 px-3 py-1 text-xs font-semibold tracking-wide text-white/90 backdrop-blur">
          {label}
        </span>
      </div>

      <div className={["relative w-full", aspectClass].join(" ")}>
        <Image
          src={src}
          alt={alt}
          fill
          className="object-cover opacity-70"
          style={{ objectPosition }}
          priority={false}
        />
        <div className="absolute inset-0 bg-[#0B1220]/40" />
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_30%_10%,rgba(37,99,235,0.15),transparent_55%)]" />
      </div>

      {overlayTitle && overlayDesc ? (
        <div className="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/10 bg-black/40 p-4 backdrop-blur shadow-[0_0_18px_rgba(0,0,0,0.35)]">
          <div className="flex items-start gap-3">
            <IconBubble icon={Sparkles} tone={overlayTone} size={40} iconSize={18} />
            <div>
              <div className="text-sm font-semibold text-white">{overlayTitle}</div>
              <div className="mt-1 text-sm text-white/75">{overlayDesc}</div>
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}

function BulletRow({
  icon,
  tone,
  children,
}: {
  icon: IconType;
  tone: "blue" | "gold";
  children: ReactNode;
}) {
  return (
    <div className="flex items-start gap-4">
      <IconBubble icon={icon} tone={tone} />
      <div className="text-sm leading-relaxed text-white/75">{children}</div>
    </div>
  );
}

