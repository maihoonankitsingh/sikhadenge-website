function StatStrip() {
  const { ref, inView } = useInViewOnce<HTMLDivElement>(0.25);

  const items = useMemo(
    () => [
      { label: "CURATED COURSES", icon: Layers, to: 10, suffix: "+" },
      { label: "CERTIFIED STUDENTS", icon: BadgeCheck, to: 12000, suffix: "+" },
      { label: "COMPLETION RATE", icon: Sparkles, to: 95, suffix: "%" },
      { label: "EXPERT INSTRUCTORS", icon: Users, to: 20, suffix: "+" },
    ],
    []
  );

  return (
    <div ref={ref} className="mt-10">
      <div
        className={cn(
          "overflow-hidden rounded-3xl border border-white/10",
          "bg-[#2563EB] shadow-[0_0_18px_rgba(37,99,235,0.55)]"
        )}
      >
        <div className="grid md:grid-cols-4">
          {items.map((it, idx) => {
            const Icon = it.icon;
            const n = useCountUp(inView, it.to, 900);

            const display =
              it.to >= 1000
                ? `${Math.round(n / 1000)}K${it.suffix === "+" ? "+" : ""}` // 12K+
                : `${Math.round(n)}${it.suffix}`;

            return (
              <div
                key={it.label}
                className={cn(
                  "flex items-center justify-center px-6 py-6 text-center",
                  idx !== 0 && "border-t border-white/15 md:border-l md:border-t-0"
                )}
              >
                <div className="flex flex-col items-center gap-2">
                  <Icon className="h-6 w-6 text-white/95" />
                  <div className="text-4xl font-extrabold tracking-tight text-white">
                    {display}
                  </div>
                  <div className="text-xs font-bold tracking-[0.22em] text-white/90">
                    {it.label}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

