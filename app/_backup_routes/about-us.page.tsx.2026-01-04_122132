  tone = "neutral",
}: {
  children: React.ReactNode;
  tone?: "neutral" | "blue" | "gold";
}) {
  const toneCls =
    tone === "blue"
      ? "border-white/15 bg-white/10 shadow-[0_0_18px_rgba(37,99,235,0.35)]"
      : tone === "gold"
      ? "border-white/15 bg-white/10 shadow-[0_0_18px_rgba(245,179,1,0.35)]"
      : "border-white/10 bg-white/5";
  return (
    <span
      className={cn(
        "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold tracking-wide text-white/90",
        toneCls
      )}
    >
      {children}
    </span>
  );
}

function IconCircle({
