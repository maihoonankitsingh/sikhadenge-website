    </span>
  );
}

function IconBadge({
  icon: Icon,
  glow = "blue",
}: {
  icon: any;
  glow?: "blue" | "gold";
}) {
  const glowClass =
    glow === "gold"
      ? "bg-[#111827] ring-1 ring-white/10 " + GOLD
      : "bg-[#111827] ring-1 ring-white/10 " + BLUE;

  const iconColor = glow === "gold" ? "text-[#F5B301]" : "text-[#2563EB]";

  return (
    <span
      className={[
        "grid h-12 w-12 place-items-center rounded-full",
        glowClass,
      ].join(" ")}
    >
      <Icon className={`h-6 w-6 ${iconColor}`} />
    </span>
  );
}

function Card({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <div
      className={[
        "rounded-3xl border border-white/10 bg-[#111827]/40",
        "shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]",
        className,
      ].join(" ")}
    >
      {children}
    </div>
  );
}

