type IconType = React.ComponentType<{ className?: string }>;

function IconBubble({
  icon: Icon,
  tone = "blue",
  size = 48,
}: {
  icon: IconType;
  tone?: "blue" | "gold";
  size?: number;
}) {
  const glow =
    tone === "blue"
      ? "shadow-[0_0_18px_rgba(37,99,235,0.55)]"
      : "shadow-[0_0_18px_rgba(245,179,1,0.55)]";

  const iconColor = tone === "blue" ? "text-[#2563EB]" : "text-[#F5B301]";

  return (
    <span
      className={[
        "shrink-0 inline-flex aspect-square items-center justify-center rounded-full overflow-hidden",
        "border border-white/10 bg-white/5 ring-1 ring-white/10",
        glow,
      ].join(" ")}
      style={{ width: size, height: size, minWidth: size, minHeight: size }}
      aria-hidden="true"
    >
      <Icon className={["h-5 w-5", iconColor].join(" ")} />
    </span>
  );
}

function SectionShell({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <section
      className={[
        "rounded-3xl border border-white/10 bg-[#111827]/40 p-6 md:p-8",
        "shadow-[0_0_40px_rgba(0,0,0,0.35)]",
        className,
      ].join(" ")}
    >
      {children}
    </section>
  );
}

function Chip({ children }: { children: React.ReactNode }) {
