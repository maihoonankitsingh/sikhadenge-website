function StatBand() {
  const stats = [
    { value: 10, suffix: "+", label: "CURATED COURSES", icon: Layers },
    { value: 12, suffix: "K+", label: "CERTIFIED STUDENTS", icon: BadgeCheck },
    { value: 95, suffix: "%", label: "COMPLETION RATE", icon: Sparkles },
    { value: 20, suffix: "+", label: "EXPERT INSTRUCTORS", icon: Users },
  ];

  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-[#2563EB] shadow-[0_0_18px_rgba(37,99,235,0.55)]">
      <div className="grid md:grid-cols-4">
        {stats.map((s, idx) => (
          <div
            key={s.label}
            className={[
              "flex flex-col items-center justify-center px-6 py-6 text-center",
              idx < stats.length - 1 ? "md:border-r md:border-white/10" : "",
            ].join(" ")}
          >
            <div className="mb-3 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10">
              <s.icon className="h-5 w-5 text-white" />
            </div>

            <div className="text-4xl font-extrabold tracking-tight text-white">
              <AnimatedNumber value={s.value} suffix={s.suffix} />
            </div>
            <div className="mt-2 text-xs font-semibold tracking-[0.24em] text-white/90">
              {s.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function ImageFrame({
  src,
  alt,
  label,
  overlayTitle,
  overlayDesc,
  overlayTone = "blue",
}: {
  src: string;
  alt: string;
  label: string;
  overlayTitle?: string;
  overlayDesc?: string;
  overlayTone?: "blue" | "gold";
}) {
  return (
    <div className="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0B1220]/50">
      <div className="absolute left-4 top-4 z-10">
        <span className="inline-flex items-center rounded-full border border-white/10 bg-black/40 px-3 py-1 text-xs font-semibold tracking-wide text-white/95 backdrop-blur">
          {label}
        </span>
      </div>

      {/* 16:9 to reduce crop; overlay to lower image focus */}
      <div className="relative aspect-[16/10] w-full">
        <Image
          src={src}
          alt={alt}
          fill
          className="object-cover object-center opacity-70"
        />
        <div className="absolute inset-0 bg-gradient-to-t from-[#0B1220]/70 via-[#0B1220]/25 to-transparent" />
      </div>

      {overlayTitle && overlayDesc ? (
        <div className="absolute bottom-4 left-4 right-4 rounded-2xl border border-white/10 bg-black/35 p-4 backdrop-blur">
          <div className="flex items-start gap-3">
            <IconBubble icon={Sparkles} tone={overlayTone} />
            <div>
              <div className="text-sm font-semibold text-white">{overlayTitle}</div>
              <div className="mt-1 text-sm text-white/75">{overlayDesc}</div>
            </div>
          </div>
        </div>
      ) : null}
    </div>
  );
}

