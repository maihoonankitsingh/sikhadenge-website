type Glow = "blue" | "gold";

function IconBadge({
  icon: Icon,
  glow = "blue",
  className = "",
}: {
  icon: any;
  glow?: Glow;
  className?: string;
}) {
  const glowShadow =
    glow === "gold"
      ? "shadow-[0_0_18px_rgba(245,179,1,0.55)]"
      : "shadow-[0_0_18px_rgba(37,99,235,0.55)]";

  const ring =
    glow === "gold"
      ? "ring-1 ring-[#F5B301]/35"
      : "ring-1 ring-[#2563EB]/35";

  const iconColor = glow === "gold" ? "text-[#F5B301]" : "text-[#2563EB]";

  return (
    <div
      className={[
        "h-12 w-12 shrink-0 rounded-full",
        "flex items-center justify-center",
        "bg-[#111827] border border-white/10",
        ring,
        glowShadow,
        className,
      ].join(" ")}
    >
      <Icon className={["h-5 w-5", iconColor].join(" ")} />
    </div>
  );
}

function Card({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <div
      className={[
        "rounded-3xl border border-white/10 bg-[#111827]/55",
        "shadow-[0_0_30px_rgba(0,0,0,0.35)]",
        className,
      ].join(" ")}
    >
      {children}
    </div>
  );
}

