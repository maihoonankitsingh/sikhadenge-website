function StatBar({ items }: { items: StatItem[] }) {
  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-[#2563EB] shadow-[0_0_18px_rgba(37,99,235,0.55)]">
      <div className="grid md:grid-cols-4">
        {items.map((s, idx) => {
          const Icon = s.icon;
          return (
            <div
              key={s.label}
              className={[
                "px-6 py-6 md:py-7",
                "flex flex-col items-center justify-center text-center",
                idx !== 0 ? "border-t border-white/10 md:border-t-0 md:border-l" : "",
                "border-white/10",
              ].join(" ")}
            >
              <IconCircle tone="muted">
                <Icon className="h-5 w-5" />
