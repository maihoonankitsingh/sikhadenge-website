type StatItem = {
  value: number;
  suffix?: string;
  label: string;
  icon: any;
};

function IconCircle({
  children,
  tone = "blue",
  size = "md",
}: {
  children: React.ReactNode;
  tone?: "blue" | "gold" | "muted";
  size?: "sm" | "md";
}) {
  const box = size === "sm" ? "h-11 w-11" : "h-12 w-12";
  const inner = size === "sm" ? "h-9 w-9" : "h-10 w-10";

  const toneCls =
    tone === "gold"
      ? "text-[#F5B301] shadow-[0_0_18px_rgba(245,179,1,0.55)]"
      : tone === "blue"
      ? "text-[#2563EB] shadow-[0_0_18px_rgba(37,99,235,0.55)]"
      : "text-white/70";

  return (
    <div
      className={[
        box,
        "shrink-0 rounded-full border border-white/10 bg-white/5",
        "grid place-items-center",
      ].join(" ")}
    >
      <div className={[inner, "rounded-full grid place-items-center", toneCls].join(" ")}>
        {children}
      </div>
    </div>
  );
}

function Card({
  className = "",
  children,
}: {
  className?: string;
  children: React.ReactNode;
}) {
  return (
    <div
      className={[
        "rounded-2xl border border-white/10 bg-[#111827]/60",
        "backdrop-blur-sm",
        className,
      ].join(" ")}
    >
      {children}
    </div>
  );
}

function Chip({ children }: { children: React.ReactNode }) {
  return (
    <span className="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80">
