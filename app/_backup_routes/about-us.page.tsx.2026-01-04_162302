}

function PillRow({
  items,
  tone = "blue",
}: {
  items: string[];
  tone?: "blue" | "gold";
}) {
  const isBlue = tone === "blue";
  return (
    <div className="mt-6 grid gap-3">
      {items.map((t) => (
        <div
          key={t}
          className="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3"
        >
          <IconBubble icon={CheckCircle2} tone={isBlue ? "gold" : "blue"} size={34} iconSize={16} />
          <div className="text-sm text-white/80">{t}</div>
        </div>
      ))}
    </div>
  );
}

function CTAButton({
  href,
  children,
  variant = "primary",
}: {
  href: string;
  children: ReactNode;
  variant?: "primary" | "ghost";
}) {
  const base =
    "inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold transition";
  if (variant === "primary") {
    return (
      <Link
        href={href}
        className={[
          base,
          "bg-[#2563EB] text-white",
          "shadow-[0_0_18px_rgba(37,99,235,0.55)]",
          "hover:bg-[#1D4ED8]",
        ].join(" ")}
      >
        {children}
      </Link>
    );
  }
  return (
    <Link
      href={href}
      className={[
        base,
        "border border-white/10 bg-white/[0.04] text-white/90",
        "hover:bg-white/10",
      ].join(" ")}
    >
      {children}
    </Link>
  );
}

