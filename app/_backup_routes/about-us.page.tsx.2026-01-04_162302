};

function IconBubble({
  icon: Icon,
  tone = "blue",
  size = 46,
  iconSize = 18,
}: {
  icon: IconType;
  tone?: "blue" | "gold";
  size?: number;
  iconSize?: number;
}) {
  const isBlue = tone === "blue";
  const ring = isBlue ? `${C.primary}55` : `${C.gold}55`;
  const glow = isBlue
    ? "shadow-[0_0_18px_rgba(37,99,235,0.55)]"
    : "shadow-[0_0_18px_rgba(245,179,1,0.55)]";
  const iconColor = isBlue ? `text-[${C.primary}]` : `text-[${C.gold}]`;

  return (
    <span
      className={[
        "relative inline-flex shrink-0 items-center justify-center rounded-full overflow-hidden",
        "border",
        "bg-white/[0.04]",
        "ring-1",
        glow,
      ].join(" ")}
      style={{
        width: size,
        height: size,
        minWidth: size,
        minHeight: size,
        borderColor: ring,
        boxShadow: isBlue
          ? "0 0 18px rgba(37,99,235,0.55)"
          : "0 0 18px rgba(245,179,1,0.55)",
      }}
      aria-hidden="true"
    >
      {/* neon radial */}
      <span
        className="absolute inset-0"
        style={{
          background: isBlue
            ? "radial-gradient(circle at 30% 30%, rgba(37,99,235,0.30), transparent 58%)"
            : "radial-gradient(circle at 30% 30%, rgba(245,179,1,0.22), transparent 58%)",
        }}
      />
      {/* subtle inner stroke */}
      <span
        className="absolute inset-[2px] rounded-full"
        style={{
          border: "1px solid rgba(255,255,255,0.06)",
          background:
            "linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02))",
        }}
      />
      <Icon
        className={["relative", iconColor].join(" ")}
        style={{ width: iconSize, height: iconSize }}
      />
    </span>
  );
}

function SectionShell({
  children,
  className = "",
}: {
  children: ReactNode;
  className?: string;
}) {
  return (
    <section
      className={[
        "rounded-3xl border bg-[#111827]/35 backdrop-blur",
        "shadow-[0_0_48px_rgba(0,0,0,0.35)]",
        "p-6 md:p-8",
        className,
      ].join(" ")}
      style={{ borderColor: C.border }}
    >
      {children}
    </section>
  );
}

function Chip({ children }: { children: ReactNode }) {
  return (
    <span className="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80">
      {children}
    </span>
  );
}

function InfoCard({
  title,
  desc,
  icon,
  tone,
}: {
  title: string;
  desc: string;
  icon: IconType;
  tone: "blue" | "gold";
}) {
