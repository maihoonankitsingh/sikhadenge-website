type IconType = ComponentType<{ className?: string; style?: CSSProperties }>;

const C = {
  base: "#0B1220",
  surface: "#111827",
  border: "rgba(255,255,255,0.10)",
  primary: "#2563EB",
  primaryDark: "#1D4ED8",
  gold: "#F5B301",
