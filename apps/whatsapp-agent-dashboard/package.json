{
  "name": "sikhadenge-whatsapp-agent-dashboard",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "worker:masterclass-flow": "tsx scripts/masterclass-flow-worker.ts",
    "test:admission-flow": "tsx tests/admission-conversation-flow.test.ts && tsx tests/contextual-message.test.ts",
    "test:masterclass-flow": "tsx tests/masterclass-community-flow.test.ts && tsx tests/masterclass-two-step-flow.test.ts",
    "test:learning-feedback": "tsx tests/conversation-feedback.test.ts",
    "test:social-agent": "tsx tests/social-webhook-agent-bridge.test.ts",
    "test:agent": "npm run test:admission-flow && npm run test:masterclass-flow && npm run test:learning-feedback && npm run test:social-agent",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "question-bank:seed": "tsx prisma/seed-question-bank.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prisma": "^6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
