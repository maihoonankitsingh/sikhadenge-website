import dotenv from 'dotenv';
dotenv.config({ path: '.env.local', quiet: true });
dotenv.config({ quiet: true });

import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

const AISENSY_API_KEY = process.env.AISENSY_API_KEY;
const AISENSY_MEDIA_URL = process.env.AISENSY_MEDIA_URL;
const AISENSY_TARGET_PHONE = process.env.AISENSY_TARGET_PHONE ? normalizePhone(process.env.AISENSY_TARGET_PHONE) : null;

function normalizePhone(phone) {
  const raw = String(phone || '').trim();
  const digits = raw.replace(/\D/g, '');

  if (!digits) return null;
  if (digits.length === 10) return `91${digits}`;
  if (digits.length === 12 && digits.startsWith('91')) return digits;

  return digits;
}

function toPositiveInt(value, fallback) {
  const n = Number(value);
  return Number.isFinite(n) && n >= 0 ? Math.floor(n) : fallback;
}

async function getMasterclassSettings() {
  const keys = [
    'masterclass_date',
    'masterclass_time',
    'masterclass_community_link',
    'masterclass_welcome_redirect_link',
    'masterclass_welcome_redirect_delay_seconds',
    'masterclass_aisensy_campaign_name',
    'masterclass_aisensy_media_url',
    'masterclass_aisensy_session_name',
    'masterclass_aisensy_joining_details_text',
    'masterclass_aisensy_link_label_text',
  ];

  const rows = await prisma.siteSetting.findMany({
    where: { key: { in: keys } }
  });

  const map = new Map(rows.map((row) => [row.key, row.value]));

  return {
    campaignName: map.get('masterclass_aisensy_campaign_name') || '15 April',
    masterclassDate: map.get('masterclass_date') || '⏰07 April | Tuesday',
    masterclassTime: map.get('masterclass_time') || '🔴Live Class | 08:00 PM',
    communityLink: map.get('masterclass_community_link') || 'https://chat.whatsapp.com/J9CbMlCEfLrGPkiUHzlLx0',
    redirectLink: map.get('masterclass_welcome_redirect_link') || 'https://chat.whatsapp.com/J9CbMlCEfLrGPkiUHzlLx0',
    redirectDelaySeconds: toPositiveInt(map.get('masterclass_welcome_redirect_delay_seconds'), 2),
    mediaUrl: map.get('masterclass_aisensy_media_url') || 'https://d3jt6ku4g6z5l8.cloudfront.net/IMAGE/67c592d9cdea2a0c17620557/1514859_Ai Expert01.jpg',
    sessionName: map.get('masterclass_aisensy_session_name') || 'Masterclass',
    joiningDetailsText: map.get('masterclass_aisensy_joining_details_text') || 'details',
    linkLabelText: map.get('masterclass_aisensy_link_label_text') || 'Community Link',
  };
}

async function sendAisensyMessage(row) {
  const destination = normalizePhone(row.phone);

  if (!destination) {
    throw new Error('Invalid phone number');
  }

  if (!AISENSY_API_KEY) throw new Error('Missing AISENSY_API_KEY');

  const settings = await getMasterclassSettings();

  if (!settings.campaignName) {
    throw new Error('Missing masterclass campaign name');
  }

  const payload = {
    apiKey: AISENSY_API_KEY,
    campaignName: settings.campaignName,
    destination,
    userName: row.name || 'Student',
    source: 'website',
    templateParams: [
      row.name || 'Student',
      settings.sessionName || 'Masterclass',
      settings.masterclassDate || '',
      settings.masterclassTime || '',
      settings.sessionName || 'Masterclass',
      settings.joiningDetailsText || 'details',
      settings.linkLabelText || 'Community Link',
      settings.communityLink || ''
    ],
    tags: ['masterclass-registered']
  };

  const finalMediaUrl = settings.mediaUrl || AISENSY_MEDIA_URL || '';

  if (finalMediaUrl) {
    payload.media = {
      url: finalMediaUrl,
      filename: 'masterclass-info.jpg'
    };
  }

  const response = await fetch('https://backend.aisensy.com/campaign/t1/api/v2', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(payload)
  });

  const text = await response.text();

  if (!response.ok) {
    throw new Error(`AiSensy API failed: ${response.status} ${text}`);
  }

  return text;
}

async function main() {
  const now = new Date();

  const rows = await prisma.aisensyReminderQueue.findMany({
    where: {
      status: 'pending',
      sendAt: { lte: now },
      ...(AISENSY_TARGET_PHONE ? { phone: AISENSY_TARGET_PHONE } : {})
    },
    orderBy: {
      sendAt: 'asc'
    },
    take: AISENSY_TARGET_PHONE ? 1 : 20
  });

  console.log(`Found ${rows.length} pending reminder(s)`);

  for (const row of rows) {
    try {
      await prisma.aisensyReminderQueue.update({
        where: { id: row.id },
        data: { status: 'processing' }
      });

      await sendAisensyMessage(row);

      await prisma.aisensyReminderQueue.update({
        where: { id: row.id },
        data: {
          status: 'sent',
          lastError: null
        }
      });

      console.log(`Sent: ${row.phone}`);
    } catch (error) {
      const retries = row.retries + 1;

      await prisma.aisensyReminderQueue.update({
        where: { id: row.id },
        data: {
          status: retries >= 5 ? 'failed' : 'pending',
          retries,
          lastError: error instanceof Error ? error.message : String(error),
          sendAt: retries >= 5 ? row.sendAt : new Date(Date.now() + 5 * 60 * 1000)
        }
      });

      console.error(`Failed: ${row.phone}`, error);
    }
  }
}

main()
  .catch((error) => {
    console.error(error);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
