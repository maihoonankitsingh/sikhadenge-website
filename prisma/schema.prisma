generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Lead {
  id           String      @id @default(cuid())
  name         String?
  phone        String?
  source       String?
  status       String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  promoCode    String?
  influencerId String?
  influencer   Influencer? @relation(fields: [influencerId], references: [id])
}

model Admission {
  id        String   @id @default(cuid())
  leadId    String?
  name      String
  phone     String
  course    String?
  feeTotal  Int?
  feePaid   Int?     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Influencer {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  passwordHash String
  promoCode    String  @unique
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  sessions InfluencerSession[]
}

model InfluencerSession {
  id           String   @id @default(cuid())
  influencerId String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id])

  @@index([influencerId])
  @@index([expiresAt])
}

model FunnelEvent {
  id             String   @id @default(cuid())
  eventId        String?
  eventName      String
  visitorId      String?
  sessionId      String?
  leadId         String?
  funnel         String?
  offerMode      String?
  entryPrice     Int?
  batchId        String?
  pagePath       String?
  source         String?
  medium         String?
  campaign       String?
  content        String?
  term           String?
  campaignId     String?
  adsetId        String?
  adId           String?
  fbclid         String?
  fbp            String?
  fbc            String?
  gclid          String?
  landingVariant String?
  eventValue     Int?
  currency       String?  @default("INR")
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([funnel, offerMode, createdAt])
  @@index([eventId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([leadId])
  @@index([campaignId])
  @@index([adId])
}

model FunnelPayment {
  id                String    @id @default(cuid())
  provider          String    @default("razorpay")
  purpose           String    @default("masterclass_entry")
  leadId            String
  funnel            String
  offerMode         String
  batchId           String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("created")
  receipt           String    @unique
  providerOrderId   String    @unique
  providerPaymentId String?   @unique
  purchaseEventId   String?   @unique
  failureCode       String?
  failureReason     String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?

  @@index([leadId, createdAt])
  @@index([funnel, offerMode, createdAt])
  @@index([status, createdAt])
  @@index([batchId])
}
