generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Lead {
  id            String      @id @default(cuid())
  name          String?
  phone         String?
  source        String?
  status        String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  influencerId  String?
  promoCode     String?
  fbclid        String?
  landingPage   String?
  referrer      String?
  utmAd         String?
  utmAdId       String?
  utmAdset      String?
  utmAdsetId    String?
  utmCampaign   String?
  utmCampaignId String?
  utmMedium     String?
  utmSource     String?
  admissions    Admission[]
  influencer    Influencer? @relation(fields: [influencerId], references: [id])
}

model Influencer {
  id           String              @id @default(cuid())
  name         String
  email        String?             @unique
  passwordHash String
  promoCode    String              @unique
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     InfluencerSession[]
  leads        Lead[]
}

model InfluencerSession {
  id           String     @id @default(cuid())
  influencerId String
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  influencer   Influencer @relation(fields: [influencerId], references: [id])

  @@index([influencerId])
  @@index([expiresAt])
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  category    String
  readTime    Int
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Admission {
  id                   String    @id @default(cuid())
  leadId               String?
  name                 String
  phone                String
  studentCode          String?   @unique
  course               String?
  feeTotal             Int?
  feePaid              Int?      @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lead                 Lead?     @relation(fields: [leadId], references: [id])
  payments             Payment[]
  // Admission KYC (store only last4 of Aadhaar; files stored as URLs)
  aadhaarLast4         String?
  highestQualification String?
  aadhaarFrontUrl      String?
  aadhaarBackUrl       String?
  qualificationDocUrl  String?

  @@index([leadId])
}

model Payment {
  id                String     @id @default(cuid())
  admissionId       String?
  razorpayPaymentId String?    @unique
  razorpayOrderId   String?
  razorpaySignature String?
  event             String?
  status            String?
  amount            Int?
  currency          String     @default("INR")
  raw               Json?
  receivedAt        DateTime?
  createdAt         DateTime   @default(now())
  admission         Admission? @relation(fields: [admissionId], references: [id])

  @@index([admissionId])
  @@index([razorpayOrderId])
  @@index([status])
}

model Attendance {
  id           String    @id @default(cuid()) // Change from Int to String
  sessionId    Int
  enrollmentId Int
  status       String
  markedAt     DateTime?

  @@unique([sessionId, enrollmentId])
}

model Batch {
  id   Int    @id @default(autoincrement()) // Auto-incremented primary key
  code String // A unique code or other identifier for the batch
  // Add other fields as required
}

model Enrollment {
  id          String   @id @default(cuid()) // Use cuid() for unique string ids
  admissionId Int
  batchId     Int
  status      String
  enrolledAt  DateTime // Add this line
  createdAt   DateTime @default(now()) // You can use default(now()) if you want to auto-generate it

  @@unique([admissionId, batchId])
}

model ClassSession {
  id          String    @id @default(cuid()) // Unique ID
  batchId     Int
  sessionDate DateTime
  title       String
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime  @default(now()) // Add this line to auto-generate createdAt timestamp

  // Add any other necessary fields
}

model MasterclassLead {
  id                   String                @id @default(uuid())
  name                 String
  phone                String                @unique // <-- Add @unique here
  email                String?
  laptop               Boolean?
  goal                 String?
  source               String?
  page                 String?
  attribution          Json?
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_content          String?
  utm_term             String?
  utm_id               String?
  utm_campaign_id      String?
  utm_adset_id         String?
  utm_ad_id            String?
  fbclid               String?
  gclid                String?
  msclkid              String?
  landing_url          String?
  referrer             String?
  updatedAt            DateTime              @updatedAt
  createdAt            DateTime              @default(now())
  masterclassZoomJoins MasterclassZoomJoin[]
  submissions          MasterclassSubmission[]
}

model PhoneOtp {
  id        String   @id @default(cuid()) // Unique ID
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int
  createdAt DateTime @default(now()) // Add createdAt with default timestamp

  // Other necessary fields...
}



model MasterclassSubmission {
  id              String          @id @default(cuid())
  leadId          String?
  name            String
  phone           String
  email           String?
  laptop          Boolean?
  goal            String?
  source          String?
  page            String?
  attribution     Json?
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_content     String?
  utm_term        String?
  utm_id          String?
  utm_campaign_id String?
  utm_adset_id    String?
  utm_ad_id       String?
  fbclid          String?
  gclid           String?
  msclkid         String?
  landing_url     String?
  referrer        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lead            MasterclassLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([phone])
  @@index([leadId])
}

model MasterclassZoomJoin {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Optional link to existing lead
  leadId String?
  lead   MasterclassLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Optional quick identifier
  phone String?

  // Attribution
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?

  // Request context
  referer   String?
  userAgent String?
  ip        String?

  // For auditing what we redirected to
  redirectTo String
  // denormalized lead fields (for reporting)
  leadName   String?
  leadEmail  String?
  leadPhone  String?

  // display helper (India time)
  joinedAtIST      String?
  name             String?
  email            String?
  joinClickedAt    DateTime?
  meetingId        String?
  zoomJoinUrl      String?
  participantName  String?
  participantEmail String?
  joinTime         DateTime?
  leaveTime        DateTime?
  durationMinutes  Int?
  status           String    @default("registered")

  @@index([createdAt])
  @@index([leadId])
}

/// ===============================
/// Sikhadenge Dashboard Phase-1 RBAC (ADD-ONLY, isolated)
/// Prefix Sd* to avoid collision with existing models.
/// ===============================

enum SdUserStatus {
  ACTIVE
  DISABLED
}

enum SdAuditEntity {
  SD_USER
  SD_ROLE
  SD_PERMISSION
  SD_SESSION
  OTHER
}

model SdUser {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  emailVerifiedAt DateTime?
  phone           String       @unique
  passwordHash    String?
  passwordSalt    String?
  status          SdUserStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  roles    SdUserRole[]
  sessions SdSession[]
  audits   SdAuditLog[] @relation("SdAuditActor")
}

model SdRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users SdUserRole[]
  perms SdRolePermission[]
}

model SdPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles SdRolePermission[]
}

model SdUserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scope     String?
  createdAt DateTime @default(now())

  user SdUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SdRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope])
  @@index([roleId])
  @@index([userId])
}

model SdRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       SdRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SdPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model SdSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user SdUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SdAuditLog {
  id        String        @id @default(cuid())
  actorId   String?
  action    String
  entity    SdAuditEntity @default(OTHER)
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime      @default(now())

  actor SdUser? @relation("SdAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([entity, entityId])
}

model SdEmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model SdAllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

model CorporateTrainingInquiry {
  id                    String   @id @default(cuid())
  fullName              String
  workEmail             String?
  phoneNumber           String
  companyName           String?
  teamSize              String?
  preferredTrainingMode String?
  trainingRequirement   String?
  source                String   @default("corporate-training")
  status                String   @default("new")
  notes                 String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([createdAt])
  @@index([phoneNumber])
  @@index([workEmail])
  @@index([status])
  @@map("corporate_training_inquiries")
}

model AisensyReminderQueue {
  id        String   @id @default(cuid())
  phone     String
  name      String
  sendAt    DateTime
  status    String   @default("pending")
  retries   Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAt])
}

model MasterclassZoomAttendance {
  id               String    @id @default(cuid())
  meetingId        String?
  participantName  String?
  participantEmail String?
  participantPhone String?
  joinTime         DateTime?
  leaveTime        DateTime?
  durationMinutes  Int?
  joinClickedAt    DateTime?
  source           String?
  status           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([participantEmail])
  @@index([participantPhone])
  @@index([meetingId])
}

// =========================
// AFFILIATE SYSTEM - STEP 1
// Safe isolated models only
// =========================

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
  CANCELLED
}

enum AffiliatePayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum AffiliateCommissionType {
  FIXED
  PERCENT
}

model AffiliatePartner {
  id            String  @id @default(cuid())
  fullName      String
  phone         String  @db.VarChar(20)
  email         String? @db.VarChar(255)
  city          String? @db.VarChar(120)
  sourceType    String? @db.VarChar(120)
  audienceType  String? @db.VarChar(120)
  instagramUrl  String? @db.VarChar(500)
  youtubeUrl    String? @db.VarChar(500)
  telegramUrl   String? @db.VarChar(500)
  websiteUrl    String? @db.VarChar(500)
  experience    String? @db.VarChar(500)
  promotionPlan String? @db.Text
  notes         String? @db.Text

  status        AffiliateStatus @default(PENDING)
  affiliateCode String?         @unique @db.VarChar(60)
  referralLink  String?         @db.VarChar(500)

  payoutName      String? @db.VarChar(180)
  payoutMethod    String? @db.VarChar(60)
  payoutUpiId     String? @db.VarChar(180)
  payoutBankName  String? @db.VarChar(180)
  payoutAccountNo String? @db.VarChar(60)
  payoutIfsc      String? @db.VarChar(30)

  approvedAt DateTime?
  rejectedAt DateTime?
  blockedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks       AffiliateClick[]
  leadCaptures AffiliateLeadCapture[]
  commissions  AffiliateCommission[]
  payouts      AffiliatePayout[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([affiliateCode])
  @@map("affiliate_partners")
}

model AffiliateClick {
  id                 String  @id @default(cuid())
  affiliatePartnerId String
  affiliateCode      String? @db.VarChar(60)

  landingPage String? @db.VarChar(500)
  referrerUrl String? @db.VarChar(1000)
  ipAddress   String? @db.VarChar(120)
  userAgent   String? @db.VarChar(2000)

  utmSource   String? @db.VarChar(120)
  utmMedium   String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(180)
  utmTerm     String? @db.VarChar(180)
  utmContent  String? @db.VarChar(180)

  createdAt DateTime @default(now())

  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  @@index([affiliatePartnerId])
  @@index([affiliateCode])
  @@index([createdAt])
  @@map("affiliate_clicks")
}

model AffiliateCommission {
  id                 String @id @default(cuid())
  affiliatePartnerId String

  leadId      String? @db.VarChar(100)
  paymentId   String? @db.VarChar(100)
  admissionId String? @db.VarChar(100)

  commissionType   AffiliateCommissionType @default(FIXED)
  commissionRate   Float?
  baseAmount       Float?                  @default(0)
  commissionAmount Float                   @default(0)

  status  AffiliateCommissionStatus @default(PENDING)
  remarks String?                   @db.Text

  approvedAt DateTime?
  paidAt     DateTime?
  reversedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  @@index([affiliatePartnerId])
  @@index([status])
  @@index([createdAt])
  @@index([leadId])
  @@index([paymentId])
  @@index([admissionId])
  @@map("affiliate_commissions")
}

model AffiliatePayout {
  id                 String @id @default(cuid())
  affiliatePartnerId String

  periodStart DateTime?
  periodEnd   DateTime?
  totalAmount Float     @default(0)

  payoutMethod    String? @db.VarChar(60)
  payoutReference String? @db.VarChar(180)
  payoutNotes     String? @db.Text

  status      AffiliatePayoutStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  @@index([affiliatePartnerId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_payouts")
}

model AffiliateLeadCapture {
  id                 String  @id @default(cuid())
  affiliatePartnerId String
  affiliateCode      String? @db.VarChar(60)

  fullName       String? @db.VarChar(180)
  phone          String? @db.VarChar(20)
  email          String? @db.VarChar(255)
  courseInterest String? @db.VarChar(180)
  sourcePage     String? @db.VarChar(500)

  externalLeadId String? @db.VarChar(120)
  captureSource  String? @db.VarChar(120)

  referrerUrl String? @db.VarChar(1000)
  utmSource   String? @db.VarChar(120)
  utmMedium   String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(180)
  utmTerm     String? @db.VarChar(180)
  utmContent  String? @db.VarChar(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  @@index([affiliatePartnerId])
  @@index([affiliateCode])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@map("affiliate_lead_captures")
}

enum CollectionPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model InstallmentCollection {
  id          String                  @id @default(cuid())
  studentName String
  phoneNumber String
  batchNumber String
  amount      Int
  currency    String                  @default("INR")
  status      CollectionPaymentStatus @default(PENDING)

  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  paidAt            DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([batchNumber])
  @@index([status])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum SdEmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  RESIGNED
  HOLD
}

enum SdEmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERN
  CONTRACT
}

enum SdWorkMode {
  WFO
  WFH
  HYBRID
}

enum SdAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEK_OFF
}

model SdEmployee {
  id            String    @id @default(cuid())
  employeeCode  String    @unique
  fullName      String
  fatherName    String?
  phone         String    @unique
  whatsappPhone String?
  email         String?   @unique
  gender        String?
  dateOfBirth   DateTime?
  address       String?   @db.Text

  department       String?
  designation      String?
  roleTitle        String?
  reportingManager String?
  joiningDate      DateTime?
  employmentType   SdEmploymentType @default(FULL_TIME)
  workMode         SdWorkMode       @default(WFO)
  shiftStart       String?
  shiftEnd         String?
  salary           Decimal?         @db.Decimal(12, 2)

  aadhaarNumber String?
  panNumber     String?
  bankName      String?
  accountNumber String?
  ifscCode      String?

  skills       String?          @db.Text
  assignedWork String?          @db.Text
  notes        String?          @db.Text
  status       SdEmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance  SdEmployeeAttendance[]
  noteHistory SdEmployeeNote[]

  @@index([status])
  @@index([department])
  @@index([designation])
  @@index([joiningDate])
  @@index([employmentType])
  @@index([workMode])
}

model SdEmployeeAttendance {
  id           String             @id @default(cuid())
  employeeId   String
  date         DateTime
  status       SdAttendanceStatus @default(PRESENT)
  checkInTime  String?
  checkOutTime String?
  workingHours Decimal?           @db.Decimal(5, 2)
  remarks      String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  employee SdEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
}

model SdEmployeeNote {
  id         String   @id @default(cuid())
  employeeId String
  note       String   @db.Text
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee SdEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([createdAt])
}

enum SdStudentStatus {
  LEAD
  INTERESTED
  ADMITTED
  ACTIVE
  HOLD
  COMPLETED
  DROPPED
}

enum SdStudentPaymentStatus {
  NOT_STARTED
  PARTIAL
  PAID
  OVERDUE
}

model SdStudent {
  id            String    @id @default(cuid())
  studentCode   String    @unique
  fullName      String
  fatherName    String?
  phone         String    @unique
  whatsappPhone String?
  email         String?   @unique
  gender        String?
  dateOfBirth   DateTime?
  city          String?
  state         String?
  address       String?   @db.Text

  courseName    String?
  courseType    String?
  batchName     String?
  batchTiming   String?
  admissionDate DateTime?
  counselorName String?
  leadSource    String?
  mode          String?

  totalFee         Decimal?               @db.Decimal(12, 2)
  paidFee          Decimal?               @db.Decimal(12, 2)
  pendingFee       Decimal?               @db.Decimal(12, 2)
  installmentPlan  String?
  firstPaymentDate DateTime?
  nextDueDate      DateTime?
  paymentStatus    SdStudentPaymentStatus @default(NOT_STARTED)

  laptopAvailable Boolean?
  joiningStatus   String?
  classStarted    Boolean?
  communityJoined Boolean?
  orientationDone Boolean?

  notes  String?         @db.Text
  status SdStudentStatus @default(LEAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteHistory SdStudentNote[]

  @@index([status])
  @@index([courseName])
  @@index([batchName])
  @@index([admissionDate])
  @@index([paymentStatus])
  @@index([leadSource])
  @@index([counselorName])
}

model SdStudentNote {
  id        String   @id @default(cuid())
  studentId String
  note      String   @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student SdStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

enum StoreProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StoreOrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model StoreProduct {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  category         String?
  shortDescription String?            @db.Text
  fullDescription  String?            @db.Text
  price            Int
  compareAtPrice   Int?
  status           StoreProductStatus @default(DRAFT)
  deliveryType     String?
  deliveryUrl      String?            @db.Text
  previewImage     String?            @db.Text
  coverImage       String?            @db.Text
  features         Json?
  faqs             Json?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  orders     StoreOrder[] @relation("StoreOrderMainProduct")
  bumpOrders StoreOrder[] @relation("StoreOrderBumpProduct")

  @@index([status, sortOrder])
  @@index([category])
}

model StoreOrder {
  id               String           @id @default(cuid())
  productId        String
  bumpProductId    String?
  name             String
  email            String?
  phone            String
  amount           Int
  baseAmount       Int?
  bumpAmount       Int?
  gstAmount        Decimal?         @db.Decimal(10, 2)
  currency         String           @default("INR")
  paymentProvider  String?
  paymentOrderId   String?          @unique
  paymentId        String?          @unique
  paymentSignature String?          @db.Text
  paymentStatus    StoreOrderStatus @default(CREATED)
  pricingMeta      Json?
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  referrer         String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  product     StoreProduct  @relation("StoreOrderMainProduct", fields: [productId], references: [id], onDelete: Restrict)
  bumpProduct StoreProduct? @relation("StoreOrderBumpProduct", fields: [bumpProductId], references: [id], onDelete: SetNull)

  age           String?
  gclid         String?
  fbclid        String?
  utmCampaignId String?
  utmAdsetId    String?
  utmAdId       String?
  landingPage   String? @db.VarChar(500)

  aiSensyQueuedAt    DateTime?
  aiSensyQueueStatus String?
  aiSensyQueueError  String?   @db.Text

  @@index([productId])
  @@index([bumpProductId])
  @@index([paymentStatus, createdAt])
  @@index([phone])
  @@index([email])
}
