function Field({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <div className="grid gap-2">
      <label className="text-xs text-[#B0B7C3]">{label}</label>
      {children}
    </div>
  );
}

function IconBubble({
  tone,
  icon,
}: {
  tone: "blue" | "gold";
  icon: "phone" | "mail" | "cap" | "users" | "chat" | "bag" | "info";
}) {
  const pulse = tone === "blue" ? "sd-pulse-blue" : "sd-pulse-gold";
  const ring =
    tone === "blue"
      ? "hover:shadow-[0_0_18px_rgba(37,99,235,0.55)]"
      : "hover:shadow-[0_0_18px_rgba(245,179,1,0.55)]";
  const stroke = tone === "blue" ? "text-[#2563EB]" : "text-[#F5B301]";

  return (
    <div
      className={[
        "grid h-12 w-12 place-items-center rounded-2xl border border-white/10 bg-[#0B1220]/90 transition-shadow",
        pulse,
        ring,
      ].join(" ")}
    >
      {icon === "phone" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path
            d="M22 16.9v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.18 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.1 9.4a16 16 0 0 0 6.5 6.5l1.07-1.1a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.9Z"
            strokeWidth="1.6"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        </svg>
      )}

      {icon === "mail" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path
            d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
            strokeWidth="1.6"
            strokeLinejoin="round"
          />
          <path d="m22 6-10 7L2 6" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" />
        </svg>
      )}

      {icon === "cap" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path d="M22 10 12 4 2 10l10 6 10-6Z" strokeWidth="1.6" strokeLinejoin="round" />
          <path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" strokeWidth="1.6" strokeLinejoin="round" />
        </svg>
      )}

      {icon === "users" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path d="M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0Z" strokeWidth="1.6" strokeLinejoin="round" />
          <path d="M4 21a8 8 0 0 1 16 0" strokeWidth="1.6" strokeLinecap="round" />
        </svg>
      )}

      {icon === "chat" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path
            d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z"
            strokeWidth="1.6"
            strokeLinejoin="round"
          />
          <path d="M8 9h8M8 13h6" strokeWidth="1.6" strokeLinecap="round" />
        </svg>
      )}

      {icon === "bag" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path d="M7 7V6a5 5 0 0 1 10 0v1" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" />
          <path d="M6 7h12l1 14H5L6 7Z" strokeWidth="1.6" strokeLinejoin="round" />
        </svg>
      )}

      {icon === "info" && (
        <svg className={`h-5 w-5 stroke-current ${stroke}`} viewBox="0 0 24 24" fill="none">
          <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" strokeWidth="1.6" />
          <path d="M12 10v6" strokeWidth="1.6" strokeLinecap="round" />
          <path d="M12 7h.01" strokeWidth="2.2" strokeLinecap="round" />
        </svg>
      )}
    </div>
  );
}

function BigCard({
  title,
  desc,
  href,
  icon,
  tone,
}: {
  title: string;
  desc: string;
  href: string;
  icon: "cap" | "users" | "chat";
  tone: "blue" | "gold";
}) {
  return (
    <a
      href={href}
      className="group rounded-3xl border border-white/10 bg-[#111827]/45 backdrop-blur p-7 transition-shadow hover:shadow-[0_0_18px_rgba(37,99,235,0.55)]"
    >
      <div className="flex items-start justify-between gap-4">
        <div className="flex items-start gap-4">
          <IconBubble tone={tone} icon={icon} />
          <div className="min-w-0">
            <div className="text-white font-semibold">{title}</div>
            <div className="mt-1 text-sm text-[#B0B7C3]">{desc}</div>
          </div>
        </div>
        <div className="text-[#9CA3AF] transition-transform group-hover:translate-x-0.5">→</div>
      </div>
    </a>
  );
}

