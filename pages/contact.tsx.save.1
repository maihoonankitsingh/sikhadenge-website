function IconCircle(props: {
  tone?: "gold" | "blue";
  children: React.ReactNode;
}) {
  const tone = props.tone || "gold";
  const ring =
    tone === "gold"
      ? "shadow-[0_0_18px_rgba(245,179,1,0.55)]"
      : "shadow-[0_0_18px_rgba(37,99,235,0.55)]";
  const bg =
    tone === "gold"
      ? "bg-white/5 border-white/10"
      : "bg-white/5 border-white/10";

  return (
    <div
      className={`grid h-12 w-12 place-items-center rounded-full border ${bg} ${ring}`}
    >
      <div className={tone === "gold" ? "text-[#F5B301]" : "text-[#2563EB]"}>
        {props.children}
      </div>
    </div>
  );
}

