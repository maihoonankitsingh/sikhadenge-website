function Chip({ children }: { children: React.ReactNode }) {
  return (
    <span
      className="inline-flex items-center rounded-full px-3 py-1 text-xs"
      style={{
        border: `1px solid ${BRAND.border}`,
        background: "rgba(17,24,39,0.55)",
        color: BRAND.text2,
        backdropFilter: "blur(10px)",
      }}
    >
      {children}
    </span>
  );
}

function NeonIcon({
  variant = "blue",
  children,
}: {
  variant?: "blue" | "gold";
  children: React.ReactNode;
}) {
  const glow = variant === "gold" ? BRAND.glowGold : BRAND.glowBlue;
  const tint =
    variant === "gold" ? "rgba(245,179,1,0.12)" : "rgba(37,99,235,0.14)";
  return (
    <div
      className="flex h-11 w-11 items-center justify-center rounded-2xl"
      style={{
        border: `1px solid ${BRAND.border}`,
        background: `linear-gradient(180deg, rgba(17,24,39,0.75), rgba(17,24,39,0.45))`,
        boxShadow: glow,
        outline: `1px solid ${tint}`,
      }}
    >
      <div style={{ color: BRAND.text }}>{children}</div>
    </div>
  );
}

function Card({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <div
      className={`rounded-[28px] ${className}`}
      style={{
        border: `1px solid ${BRAND.border}`,
        background: "rgba(17,24,39,0.55)",
        backdropFilter: "blur(12px)",
      }}
    >
      {children}
    </div>
  );
}

function SectionHeading({
  title,
  subtitle,
  center = true,
}: {
  title: string;
  subtitle?: string;
  center?: boolean;
}) {
  return (
    <div className={center ? "text-center" : ""}>
      <h2
        className="text-3xl font-semibold tracking-tight md:text-4xl"
