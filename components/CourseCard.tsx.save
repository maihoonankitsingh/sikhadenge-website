import Link from "next/link";
import type { Course } from "../lib/courses";

type CourseCardProps = {
  course: Course;
};

export default function CourseCard({ course }: CourseCardProps) {
  const href = `/course/${course.slug}`;

  return (
    <div className="group relative overflow-hidden rounded-3xl border border-white/10 bg-[#111827]/55 shadow-[0_18px_60px_rgba(0,0,0,0.45)] backdrop-blur">
      {/* Image */}
      <div className="relative h-56">
        <img
          src={course.coverImage}
          alt={course.title}
          className="h-full w-full object-cover object-center"
          loading="lazy"
        />

        {/* Gradient overlay */}
        <div className="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-[#0B1220]/35 to-[#0B1220]/95" />

        {/* Category pill (no cut) */}
        <div className="absolute left-4 top-4 max-w-[calc(100%-2rem)]">
          <span className="block truncate rounded-full border border-white/10 bg-white/15 px-3 py-1 text-[12px] font-medium text-white/90 backdrop-blur-sm">
            {course.category}
          </span>
        </div>
      </div>

      {/* Content */}
      <div className="flex min-h-[210px] flex-col px-6 pb-6 pt-5">
        {/* Title (smaller + stable height) */}
       <h3
           className="overflow-hidden whitespace-nowrap text-ellipsis text-[16px] font-semibold leading-tight tracking-tight text-white/95"
              title={course.title}
             >
            {course.title}
         </h3>

        {/* Chips */}
        <div className="mt-4 flex flex-wrap gap-2">
          <span className="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80">
            {course.durationText}
          </span>
          <span className="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80">
            {course.hoursText}
          </span>
          <span className="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/80">
            {course.startText}
          </span>
        </div>

        {/* Button aligned same for all cards */}
        <div className="mt-auto pt-5">
          <Link
            href={href}
            className="inline-flex h-12 w-full items-center justify-center rounded-2xl bg-[#2563EB] text-sm font-semibold text-white shadow-[0_0_18px_rgba(37,99,235,0.35)] transition hover:bg-[#1D4ED8]"
          >
            View Course <span className="ml-2">→</span>
          </Link>
        </div>
      </div>
    </div>
  );
}

