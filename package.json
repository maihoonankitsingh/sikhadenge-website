{
  "name": "sikhadenge-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:funnel-security": "rm -rf .tmp/funnel-security && npx tsc lib/funnel/checkoutToken.ts lib/funnel/razorpay.ts --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp/funnel-security && node scripts/funnel-security-check.cjs",
    "test:funnel-db": "node scripts/funnel-db-smoke.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.16.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^8",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.6",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
