# =============================================================
# Sikhadenge — Environment variables (TEMPLATE)
# Isko copy karke ".env" banao (local) ya Vercel me daalo (prod).
# .env ko GIT me kabhi commit mat karo (already .gitignore me hai).
# Real secrets yahan mat likho — ye sirf template hai.
# =============================================================

# ---------- Database (REQUIRED) ----------
# Postgres connection string. Neon/Supabase/RDS se milega.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Sirf local "prisma migrate dev" ke liye (prod me zaroorat nahi):
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/shadowdb?sslmode=require"

# ---------- Admin panel (REQUIRED) ----------
# Admin login (/admin/login). Strong password rakho.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"
# Session sign karne ka secret. 24+ chars. Generate: openssl rand -base64 32
ADMIN_COOKIE_SECRET="generate-a-long-random-string-min-24-chars"

# ---------- Live classes · 100ms (Phase 3) ----------
# Optional: na ho to live scheduling chalti hai par room provision nahi hota.
HMS_ACCESS_KEY=""
HMS_SECRET=""
HMS_TEMPLATE_ID=""
HMS_SUBDOMAIN="yourname.app.100ms.live"
HMS_WEBHOOK_SECRET=""

# ---------- Payments · Razorpay (Phase 5) ----------
# Optional: na ho to paid checkout "not configured" dega (free enroll chalta hai).
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""
# Influencer coupon discount % (optional, default 10)
REFERRAL_DISCOUNT_PERCENT="10"

# ---------- Notifications (Phase 6) ----------
# Sab optional — na ho to sirf in-app notification banti hai.
RESEND_API_KEY=""
EMAIL_FROM="Sikhadenge <noreply@sikhadenge.in>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ---------- Existing marketing site (optional) ----------
NEXT_PUBLIC_META_PIXEL_ID=""
NEODOVE_ENDPOINT=""
